<Project>

  <PropertyGroup>
	<!-- Root drop folders -->
	<ArtifactsBin>$(SolutionDir)artifacts\bin\</ArtifactsBin>
	<ArtifactsObj>$(SolutionDir)artifacts\obj\</ArtifactsObj>
  </PropertyGroup>

  <!-- Managed projects (.NET: csproj, fsproj, vbproj) -->
  <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' != ''">
	<!-- Solution-wide default for .NET projects -->
	<BaseOutputPath>$(ArtifactsBin)</BaseOutputPath>
	<BaseIntermediateOutputPath>$(ArtifactsObj)</BaseIntermediateOutputPath>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	<!-- Optional to keep platforms consistent -->
	<PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Native C++ projects -->
  <PropertyGroup Condition="'$(ProjectExtension)' == '.vcxproj'">
	<!-- For C++ use OutDir/IntDir, *not* OutputPath -->
	<OutDir>$(ArtifactsBin)$(Configuration)\</OutDir>
	<!-- Keep obj separated per project to avoid collisions -->
	<IntDir>$(ArtifactsObj)$(ProjectName)\$(Configuration)\</IntDir>
  </PropertyGroup>

</Project>
