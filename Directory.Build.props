<Project>

  <!-- ================================================================
       CENTRALIZED VERSION MANAGEMENT
        ================================================================
               ALL PROJECTS (BackupUI, BackupService, BackupEngine) use this single version.
              Change version HERE and it updates everywhere automatically.
       Current Version: 6.2.3.90
               Last Updated: 5/1/2026

             UPDATE VERSION IN ONE PLACE: Change ProductVersion property below.
             All version properties (Version, AssemblyVersion, FileVersion, 
             InformationalVersion) reference this single variable.
             ================================================================ -->
       <PropertyGroup>
          <!-- SINGLE VERSION DEFINITION - Update this value only -->
                                <ProductVersion>6.2.3.90</ProductVersion>
    
    <!-- All version properties use the ProductVersion variable -->
    <Version>$(ProductVersion)</Version>
    <AssemblyVersion>$(ProductVersion)</AssemblyVersion>
    <FileVersion>$(ProductVersion)</FileVersion>
    <InformationalVersion>$(ProductVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

 <!-- ================================================================
      CENTRALIZED OUTPUT PATHS
      ================================================================
      All build output goes to: artifacts/bin/<Configuration>/
      Intermediate files go to: artifacts/obj/<ProjectName>/<Configuration>/
      
      CRITICAL: Do not modify OutputPath or IntermediateOutputPath settings.
      These paths are used by all projects for consistent build structure.
      ================================================================ -->
 <PropertyGroup>
<SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
<!-- Root drop folders -->
<ArtifactsBin>$(SolutionDir)artifacts\bin\</ArtifactsBin>
<ArtifactsObj>$(SolutionDir)artifacts\obj\</ArtifactsObj>
 </PropertyGroup>

  <!-- ================================================================
       C++ PROJECTS (BackupEngine.vcxproj)
       ================================================================
       Uses OutDir/IntDir (not OutputPath)
       PlatformToolset and WindowsTargetPlatformVersion are centralized here.

       WINDOWS SDK VERSION OPTIONS:
       - 10.0           = Use latest installed SDK (auto-select)
       - 10.0.19041.0   = Windows 10 2004 (broad compatibility)
       - 10.0.22621.0   = Windows 11 22H2
       - 10.0.26100.0   = Windows 11 24H2 (latest)
       ================================================================ -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <!-- For C++ use OutDir/IntDir, *not* OutputPath -->
    <OutDir>$(ArtifactsBin)$(Configuration)\</OutDir>
    <!-- Keep obj separated per project to avoid collisions -->
    <IntDir>$(ArtifactsObj)$(MSBuildProjectName)\$(Configuration)\</IntDir>
    <!-- CENTRALIZED C++ TOOLSET SETTINGS -->
    <PlatformToolset>v145</PlatformToolset>
    <!-- Specific Windows 10 SDK for broad compatibility -->
    <WindowsTargetPlatformVersion>10.0.19041.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <!-- ================================================================
       .NET PROJECTS (BackupUI.csproj, BackupService.csproj)
       ================================================================
       CRITICAL SETTINGS - DO NOT REMOVE:
       
       1. GenerateRuntimeConfigurationFiles=true
          - REQUIRED for .exe projects to launch
          - Creates BackupUI.runtimeconfig.json and BackupService.runtimeconfig.json
          - Without these files: ".NET Desktop Runtime required" error
       
       2. ProduceReferenceAssembly=false
          - Ensures runtime config generation works with custom OutputPath
          - Required when using centralized build output
       
       3. AppendTargetFrameworkToOutputPath=false
          - Prevents net8.0-windows subfolder
          - Keeps all binaries in same directory
       
       4. GenerateDependencyFile=true
          - Creates .deps.json files for runtime dependencies
       ================================================================ -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' != '.vcxproj'">
    <!-- Ensure Configuration has a value (defaults to Debug if not set) -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <!-- Set OutputPath directly - all binaries go to same folder -->
    <OutputPath>$(ArtifactsBin)$(Configuration)\</OutputPath>
    <!-- Keep obj separated per project to avoid collisions 
         CRITICAL: Must match format MSBuild expects for runtime config generation! -->
    <BaseIntermediateOutputPath>$(ArtifactsObj)$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
    <!-- Don't append TFM or RID to paths -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Optional to keep platforms consistent -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- CRITICAL: Ensure runtime config files are generated for ALL executables 
         Removing these will cause ".NET Desktop Runtime required" errors! -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <!-- Force runtime config generation even with custom output paths -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- CRITICAL FIX: Override runtime config output path to match our OutputPath -->
    <RuntimeConfigurationFilesOutputPath>$(OutputPath)</RuntimeConfigurationFilesOutputPath>
    <!-- Keep documentation and source-note artifacts out of build outputs -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EmbedAllSources>false</EmbedAllSources>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Force full rebuild to ensure runtime configs regenerate in Visual Studio -->
    <DisableIncrementalBuild Condition="'$(Configuration)' == 'Release'">true</DisableIncrementalBuild>
  </PropertyGroup>
  
  <!-- ================================================================
       BUILD DIAGNOSTICS
       ================================================================
       Outputs build paths to console for verification
       ================================================================ -->
  <Target Name="__EchoOutput" BeforeTargets="Build">
    <Message Importance="High" Text="[$(MSBuildProjectName)] SolutionDir=$(SolutionDir) Ext=$(MSBuildProjectExtension) OutDir=$(OutDir) OutputPath=$(OutputPath)" />
  </Target>

</Project>

