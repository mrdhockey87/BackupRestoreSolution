<Project Sdk="Microsoft.NET.Sdk.Worker">
<PropertyGroup>
  <TargetFramework>net8.0-windows</TargetFramework>
  <Nullable>enable</Nullable>
  <OutputType>Exe</OutputType>
  <Platforms>x64</Platforms>
  <RootNamespace>SecureServerBackupService</RootNamespace>
  <AssemblyName>SecureServerBackupService</AssemblyName>
  <Win32Resource>E:\VisualStudioProjects\BackupRestoreSolution\BackupRestoreSolution\BackupService\Resources\SSB_LogoWinIcosM.res</Win32Resource>
  <AssemblyTitle>SecureServerBackupService</AssemblyTitle>
  <Title>Secure Server Backup Service</Title>
  <!-- Version, OutputPath, and Runtime config generation come from Directory.Build.props -->
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.4" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.4" />
    <PackageReference Include="System.Management" Version="10.0.4" />
  </ItemGroup>

  <!-- Reference to BackupCommon for shared models and logging -->
  <ItemGroup>
    <ProjectReference Include="..\BackupCommon\BackupCommon.csproj" />
  </ItemGroup>
  
  <!-- SecureServerBackupEngine.dll will be copied by BackupUI project to centralized output -->
</Project>
