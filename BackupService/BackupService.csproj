<Project Sdk="Microsoft.NET.Sdk.Worker">
<PropertyGroup>
  <TargetFramework>net8.0-windows</TargetFramework>
  <Nullable>enable</Nullable>
  <OutputType>Exe</OutputType>
  <Platforms>x64</Platforms>
  <!-- Version, OutputPath, and Runtime config generation come from Directory.Build.props -->
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.3" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.3" />
    <PackageReference Include="System.Management" Version="10.0.3" />
  </ItemGroup>

  <!-- Reference to BackupUI for shared models and services -->
  <ItemGroup>
    <ProjectReference Include="..\BackupUI\BackupUI.csproj" />
  </ItemGroup>
  
  <!-- BackupEngine.dll will be copied by BackupUI project to centralized output -->
</Project>
