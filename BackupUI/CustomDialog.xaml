<Window x:Class="BackupUI.CustomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" 
        Height="250" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Turquoise Theme Colors -->
        <SolidColorBrush x:Key="WindowBackground" Color="#F5FFFF"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#B0E0E6"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#20B2AA"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#008B8B"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#20B2AA"/>
        <SolidColorBrush x:Key="InfoBackground" Color="#E0F7F7"/>
        <SolidColorBrush x:Key="WarningBackground" Color="#FFF8DC"/>
        <SolidColorBrush x:Key="ErrorBackground" Color="#FFE4E1"/>
        
        <!-- Button Style -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#008080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFAFEEEE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF48D1CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="2" 
            CornerRadius="5"
            Background="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Content -->
                <RowDefinition Height="60"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource HeaderBackground}"
                    CornerRadius="3,3,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="txtTitle" 
                               Text="Message"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="Black"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                    <Button x:Name="btnClose"
                            Content="✕"
                            Style="{StaticResource CloseButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Icon -->
                    <ColumnDefinition Width="*"/>
                    <!-- Message -->
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <TextBlock x:Name="txtIcon"
                           Grid.Column="0"
                           FontSize="48"
                           VerticalAlignment="Top"
                           Margin="0,10,20,0"/>

                <!-- Message -->
                <ScrollViewer Grid.Column="1" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="txtMessage"
                               Text="Message text here"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="Black"
                               VerticalAlignment="Center"/>
                </ScrollViewer>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button x:Name="btnPrimary"
                        Content="OK"
                        Style="{StaticResource DialogButton}"
                        IsDefault="True"
                        Click="BtnPrimary_Click"/>
                <Button x:Name="btnSecondary"
                        Content="Cancel"
                        Style="{StaticResource DialogButton}"
                        IsCancel="True"
                        Visibility="Collapsed"
                        Click="BtnSecondary_Click"/>
                <Button x:Name="btnTertiary"
                        Content="No"
                        Style="{StaticResource DialogButton}"
                        Visibility="Collapsed"
                        Click="BtnTertiary_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
