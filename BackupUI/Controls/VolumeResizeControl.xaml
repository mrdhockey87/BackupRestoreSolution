<UserControl
	x:Class="SecureServerBackup.Controls.VolumeResizeControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	MinHeight="250"
	d:DesignHeight="300"
	d:DesignWidth="800"
	mc:Ignorable="d">
	<UserControl.Resources>
		<!--  Converter for size to width  -->
		<Style x:Key="VolumeBarStyle" TargetType="Border">
			<Setter Property="BorderBrush" Value="#2196F3" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Margin" Value="1,0" />
		</Style>

		<Style x:Key="ArrowThumbStyle" TargetType="Thumb">
			<Setter Property="Width" Value="16" />
			<Setter Property="Height" Value="40" />
			<Setter Property="Cursor" Value="SizeWE" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Thumb">
						<Grid Background="Transparent">
							<!--  Arrow Visual  -->
							<Path
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Data="M 0,0 L 8,10 L 0,20 Z"
								Fill="#FF6B6B"
								Stroke="DarkRed"
								StrokeThickness="1" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="80" />
			<RowDefinition Height="60" />
			<RowDefinition Height="80" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Title  -->
		<TextBlock
			Grid.Row="0"
			Margin="0,0,0,10"
			FontSize="16"
			FontWeight="Bold"
			Text="Volume Resize Configuration" />

		<!--  Source Backup Bar  -->
		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock
				Grid.Row="0"
				Margin="0,0,0,5"
				FontWeight="SemiBold"
				Text="Original Backup Volumes" />

			<!--  Source volumes container  -->
			<Border
				x:Name="SourceBarContainer"
				Grid.Row="1"
				Height="50"
				Background="#ECEFF1"
				BorderBrush="#607D8B"
				BorderThickness="2"
				CornerRadius="4" />

			<!--  Size label  -->
			<TextBlock
				x:Name="txtSourceSize"
				Grid.Row="2"
				Margin="0,5,0,0"
				HorizontalAlignment="Right"
				FontSize="11"
				Foreground="{StaticResource SecondaryText}"
				Text="Total: 0 GB" />
		</Grid>

		<!--  Arrows/Labels Area  -->
		<Grid Grid.Row="2">
			<Canvas x:Name="ArrowCanvas" Background="Transparent" />
		</Grid>

		<!--  Target Disk Bar  -->
		<Grid Grid.Row="3">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock
				Grid.Row="0"
				Margin="0,0,0,5"
				FontWeight="SemiBold"
				Text="Target Disk Configuration" />

			<!--  Target volumes container  -->
			<Border
				x:Name="TargetBarContainer"
				Grid.Row="1"
				Height="50"
				Background="{StaticResource SuccessBackground}"
				BorderBrush="#4CAF50"
				BorderThickness="2"
				CornerRadius="4" />

			<!--  Size labels  -->
			<StackPanel
				Grid.Row="2"
				Margin="0,5,0,0"
				HorizontalAlignment="Right"
				Orientation="Horizontal">
				<TextBlock
					x:Name="txtTargetUsed"
					Margin="0,0,15,0"
					FontSize="11"
					Foreground="{StaticResource SecondaryText}"
					Text="Used: 0 GB" />
				<TextBlock
					x:Name="txtTargetFree"
					FontSize="11"
					Foreground="#4CAF50"
					Text="Free: 0 GB" />
			</StackPanel>
		</Grid>

		<!--  Action Buttons  -->
		<StackPanel
			Grid.Row="4"
			Margin="0,15,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				x:Name="btnAutoFit"
				Width="100"
				Height="30"
				Margin="0,0,10,0"
				Click="btnAutoFit_Click"
				Content="Auto Fit" />
			<Button
				x:Name="btnReset"
				Width="100"
				Height="30"
				Click="btnReset_Click"
				Content="Reset" />
		</StackPanel>
	</Grid>
</UserControl>
