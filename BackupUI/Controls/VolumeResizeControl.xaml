<UserControl x:Class="BackupUI.Controls.VolumeResizeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="800"
             MinHeight="250">
    <UserControl.Resources>
        <!-- Converter for size to width -->
        <Style x:Key="VolumeBarStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#2196F3"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="1,0"/>
        </Style>

        <Style x:Key="ArrowThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <!-- Arrow Visual -->
                            <Path Data="M 0,0 L 8,10 L 0,20 Z" 
                                  Fill="#FF6B6B"
                                  Stroke="DarkRed"
                                  StrokeThickness="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Volume Resize Configuration" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <!-- Source Backup Bar -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Original Backup Volumes" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,5"/>

            <!-- Source volumes container -->
            <Border Grid.Row="1" 
                    x:Name="SourceBarContainer"
                    BorderBrush="#607D8B" 
                    BorderThickness="2" 
                    CornerRadius="4"
                    Background="#ECEFF1"
                    Height="50"/>

            <!-- Size label -->
            <TextBlock Grid.Row="2" 
                       x:Name="txtSourceSize"
                       Text="Total: 0 GB" 
                       HorizontalAlignment="Right" 
                       Margin="0,5,0,0"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryText}"/>
        </Grid>

        <!-- Arrows/Labels Area -->
        <Grid Grid.Row="2">
            <Canvas x:Name="ArrowCanvas" Background="Transparent"/>
        </Grid>

        <!-- Target Disk Bar -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Target Disk Configuration" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,5"/>

            <!-- Target volumes container -->
            <Border Grid.Row="1" 
                    x:Name="TargetBarContainer"
                    BorderBrush="#4CAF50" 
                    BorderThickness="2" 
                    CornerRadius="4"
                    Background="{StaticResource SuccessBackground}"
                    Height="50"/>

            <!-- Size labels -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                <TextBlock x:Name="txtTargetUsed"
                           Text="Used: 0 GB" 
                           FontSize="11"
                           Foreground="{StaticResource SecondaryText}"
                           Margin="0,0,15,0"/>
                <TextBlock x:Name="txtTargetFree"
                           Text="Free: 0 GB" 
                           FontSize="11"
                           Foreground="#4CAF50"/>
            </StackPanel>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnAutoFit" 
                    Content="Auto Fit" 
                    Width="100" 
                    Height="30" 
                    Margin="0,0,10,0"
                    Click="btnAutoFit_Click"/>
            <Button x:Name="btnReset" 
                    Content="Reset" 
                    Width="100" 
                    Height="30"
                    Click="btnReset_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
