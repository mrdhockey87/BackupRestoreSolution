<Window
	x:Class="SecureServerBackup.Windows.ExportOptionsDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Export Options"
	Width="350"
	Height="200"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Title  -->
		<TextBlock
			Grid.Row="0"
			Margin="0,0,0,15"
			FontSize="14"
			FontWeight="SemiBold"
			Text="Select Export Format:" />

		<!--  Format Options  -->
		<StackPanel Grid.Row="1" Margin="10,0,0,0">
			<RadioButton
				Name="rbCSV"
				Margin="0,5"
				Content="CSV (Comma-Separated Values)"
				FontSize="13"
				IsChecked="True" />
			<TextBlock
				Margin="20,0,0,10"
				FontSize="11"
				Foreground="{StaticResource SecondaryText}"
				Text="Best for opening in Excel or other spreadsheet programs" />

			<RadioButton
				Name="rbText"
				Margin="0,5"
				Content="Plain Text (.txt)"
				FontSize="13" />
			<TextBlock
				Margin="20,0,0,10"
				FontSize="11"
				Foreground="{StaticResource SecondaryText}"
				Text="Human-readable format, suitable for viewing in any text editor" />
		</StackPanel>

		<!--  Buttons  -->
		<StackPanel
			Grid.Row="2"
			Margin="0,20,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				Width="80"
				Height="30"
				Margin="5,0"
				Click="OK_Click"
				Content="OK"
				IsDefault="True" />
			<Button
				Width="80"
				Height="30"
				Margin="5,0"
				Content="Cancel"
				IsCancel="True" />
		</StackPanel>
	</Grid>
</Window>
