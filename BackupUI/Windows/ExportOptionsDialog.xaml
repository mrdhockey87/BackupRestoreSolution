<Window x:Class="BackupUI.Windows.ExportOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Options"
        Height="200"
        Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Select Export Format:" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,15"/>

        <!-- Format Options -->
        <StackPanel Grid.Row="1" Margin="10,0,0,0">
            <RadioButton Name="rbCSV" 
                         Content="CSV (Comma-Separated Values)" 
                         IsChecked="True" 
                         Margin="0,5"
                         FontSize="13"/>
            <TextBlock Text="Best for opening in Excel or other spreadsheet programs" 
                       Margin="20,0,0,10" 
                       Foreground="{StaticResource SecondaryText}" 
                       FontSize="11"/>
            
            <RadioButton Name="rbText" 
                         Content="Plain Text (.txt)" 
                         Margin="0,5"
                         FontSize="13"/>
            <TextBlock Text="Human-readable format, suitable for viewing in any text editor" 
                       Margin="20,0,0,10" 
                       Foreground="{StaticResource SecondaryText}" 
                       FontSize="11"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="OK" 
                    Width="80" 
                    Height="30" 
                    IsDefault="True" 
                    Click="OK_Click" 
                    Margin="5,0"/>
            <Button Content="Cancel" 
                    Width="80" 
                    Height="30" 
                    IsCancel="True" 
                    Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>
