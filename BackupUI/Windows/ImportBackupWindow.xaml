<Window
	x:Class="SecureServerBackup.Windows.ImportBackupWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Import Backup"
	Width="700"
	Height="500"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<TextBlock
			Grid.Row="0"
			Margin="0,0,0,15"
			FontSize="18"
			FontWeight="Bold"
			Text="Import External Backup" />

		<!--  File Selection  -->
		<GroupBox
			Grid.Row="1"
			Margin="0,0,0,15"
			Header="Select Backup File">
			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!--  File Path  -->
				<TextBlock
					Grid.Row="0"
					Margin="0,0,0,5"
					Text="Backup File:" />
				<Grid Grid.Row="1" Margin="0,0,0,15">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBox
						Name="txtFilePath"
						Grid.Column="0"
						Height="30"
						Margin="0,0,10,0"
						VerticalContentAlignment="Center" />
					<Button
						Grid.Column="1"
						Width="100"
						Height="30"
						Click="Browse_Click"
						Content="Browse..." />
				</Grid>

				<!--  Validation Status  -->
				<Border
					Name="pnlValidation"
					Grid.Row="2"
					Margin="0,0,0,15"
					Padding="10"
					CornerRadius="5"
					Visibility="Collapsed">
					<StackPanel>
						<TextBlock
							Name="txtValidationStatus"
							Margin="0,0,0,10"
							FontWeight="SemiBold" />
						<TextBlock Name="txtValidationDetails" TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<!--  Backup Information  -->
				<GroupBox
					Name="grpBackupInfo"
					Grid.Row="3"
					Header="Backup Information"
					Visibility="Collapsed">
					<Grid Margin="10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="120" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Margin="0,5"
							FontWeight="SemiBold"
							Text="Format:" />
						<TextBlock
							Name="txtFormat"
							Grid.Row="0"
							Grid.Column="1"
							Margin="0,5"
							Text="-" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Margin="0,5"
							FontWeight="SemiBold"
							Text="Backup Name:" />
						<TextBlock
							Name="txtBackupName"
							Grid.Row="1"
							Grid.Column="1"
							Margin="0,5"
							Text="-" />

						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Margin="0,5"
							FontWeight="SemiBold"
							Text="Backup Type:" />
						<TextBlock
							Name="txtBackupType"
							Grid.Row="2"
							Grid.Column="1"
							Margin="0,5"
							Text="-" />

						<TextBlock
							Grid.Row="3"
							Grid.Column="0"
							Margin="0,5"
							FontWeight="SemiBold"
							Text="Date Created:" />
						<TextBlock
							Name="txtTimestamp"
							Grid.Row="3"
							Grid.Column="1"
							Margin="0,5"
							Text="-" />

						<TextBlock
							Grid.Row="4"
							Grid.Column="0"
							Margin="0,5"
							FontWeight="SemiBold"
							Text="Size:" />
						<TextBlock
							Name="txtSize"
							Grid.Row="4"
							Grid.Column="1"
							Margin="0,5"
							Text="-" />

						<TextBlock
							Grid.Row="5"
							Grid.Column="0"
							Margin="0,5"
							FontWeight="SemiBold"
							Text="Compressed:" />
						<TextBlock
							Name="txtCompressed"
							Grid.Row="5"
							Grid.Column="1"
							Margin="0,5"
							Text="-" />

						<TextBlock
							Grid.Row="6"
							Grid.Column="0"
							Margin="0,5"
							FontWeight="SemiBold"
							Text="Encrypted:" />
						<TextBlock
							Name="txtEncrypted"
							Grid.Row="6"
							Grid.Column="1"
							Margin="0,5"
							Text="-" />
					</Grid>
				</GroupBox>
			</Grid>
		</GroupBox>

		<!--  Job Name Override  -->
		<GroupBox
			Grid.Row="2"
			Margin="0,0,0,15"
			Header="Import Options">
			<StackPanel Margin="10">
				<CheckBox
					Name="chkRenameJob"
					Margin="0,0,0,10"
					Checked="RenameJob_Changed"
					Content="Rename imported backup"
					Unchecked="RenameJob_Changed" />
				<StackPanel Name="pnlRename" Visibility="Collapsed">
					<TextBlock Margin="0,0,0,5" Text="New Job Name:" />
					<TextBox
						Name="txtJobName"
						Height="30"
						VerticalContentAlignment="Center" />
				</StackPanel>
			</StackPanel>
		</GroupBox>

		<!--  Buttons  -->
		<StackPanel
			Grid.Row="3"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				Name="btnImport"
				Width="100"
				Height="35"
				Margin="0,0,10,0"
				Click="Import_Click"
				Content="Import"
				IsEnabled="False" />
			<Button
				Width="100"
				Height="35"
				Click="Cancel_Click"
				Content="Cancel" />
		</StackPanel>
	</Grid>
</Window>
