<Window x:Class="BackupUI.Windows.ImportBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Backup"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Import External Backup" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15"/>

        <!-- File Selection -->
        <GroupBox Grid.Row="1" Header="Select Backup File" Margin="0,0,0,15">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- File Path -->
                <TextBlock Grid.Row="0" Text="Backup File:" Margin="0,0,0,5"/>
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="txtFilePath" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Browse..." Width="100" Height="30" Click="Browse_Click"/>
                </Grid>

                <!-- Validation Status -->
                <Border Grid.Row="2" 
                        Name="pnlValidation" 
                        Visibility="Collapsed" 
                        Padding="10" 
                        Margin="0,0,0,15"
                        CornerRadius="5">
                    <StackPanel>
                        <TextBlock Name="txtValidationStatus" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Name="txtValidationDetails" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Backup Information -->
                <GroupBox Grid.Row="3" Name="grpBackupInfo" Header="Backup Information" Visibility="Collapsed">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Format:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Name="txtFormat" Text="-" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Backup Name:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Name="txtBackupName" Text="-" Margin="0,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Backup Type:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Name="txtBackupType" Text="-" Margin="0,5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Date Created:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Name="txtTimestamp" Text="-" Margin="0,5"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Size:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Name="txtSize" Text="-" Margin="0,5"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Compressed:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Name="txtCompressed" Text="-" Margin="0,5"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Encrypted:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Name="txtEncrypted" Text="-" Margin="0,5"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>

        <!-- Job Name Override -->
        <GroupBox Grid.Row="2" Header="Import Options" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <CheckBox Name="chkRenameJob" Content="Rename imported backup" Checked="RenameJob_Changed" Unchecked="RenameJob_Changed" Margin="0,0,0,10"/>
                <StackPanel Name="pnlRename" Visibility="Collapsed">
                    <TextBlock Text="New Job Name:" Margin="0,0,0,5"/>
                    <TextBox Name="txtJobName" Height="30" VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnImport" Content="Import" Width="100" Height="35" Margin="0,0,10,0" Click="Import_Click" IsEnabled="False"/>
            <Button Content="Cancel" Width="100" Height="35" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
