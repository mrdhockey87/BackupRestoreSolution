<Window
	x:Class="SecureServerBackup.Windows.VolumeSelectionWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Select Target Volume"
	Width="700"
	Height="420"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock
			Grid.Row="0"
			Margin="0,0,0,10"
			FontWeight="SemiBold"
			Text="Select the target volume to be formatted and restored."
			TextWrapping="Wrap" />

		<ListBox
			x:Name="lstVolumes"
			Grid.Row="1"
			DisplayMemberPath="DisplayName"
			SelectionChanged="VolumeList_SelectionChanged" />

		<CheckBox
			x:Name="chkShowHiddenPartitions"
			Grid.Row="2"
			Margin="0,8,0,0"
			Click="ShowHiddenPartitions_Click"
			Content="Show Hidden Partitions"
			ToolTip="Include EFI, Recovery, and System Reserved partitions in the volume list" />

		<StackPanel
			Grid.Row="3"
			Margin="0,10,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				x:Name="btnSelect"
				Width="100"
				Height="30"
				Margin="0,0,10,0"
				Click="Select_Click"
				Content="Select"
				IsEnabled="False" />
			<Button
				Width="100"
				Height="30"
				Click="Cancel_Click"
				Content="Cancel" />
		</StackPanel>
	</Grid>
</Window>
