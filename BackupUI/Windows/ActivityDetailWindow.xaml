<Window
	x:Class="SecureServerBackup.Windows.ActivityDetailWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:SecureServerBackup.Converters"
	Title="Activity Details"
	Width="1200"
	Height="700"
	WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
	</Window.Resources>
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Header with Controls  -->
		<StackPanel
			Grid.Row="0"
			Margin="0,0,0,10"
			Orientation="Vertical">
			<!--  Title and Refresh  -->
			<StackPanel
				Height="50"
				Background="{StaticResource PanelBackground}"
				Orientation="Horizontal">
				<TextBlock
					Name="txtTitle"
					Margin="15,0,20,0"
					VerticalAlignment="Center"
					FontSize="18"
					FontWeight="Bold"
					Text="Activity Details" />
				<Button
					Width="100"
					Height="32"
					Margin="5"
					Click="Refresh_Click"
					Content="Refresh" />
				<ComboBox
					Name="cmbFilterLevel"
					Width="140"
					Height="32"
					Margin="5"
					SelectionChanged="FilterLevel_Changed">
					<ComboBoxItem Content="All" IsSelected="True" />
					<ComboBoxItem Content="Info" />
					<ComboBoxItem Content="Success" />
					<ComboBoxItem Content="Warning" />
					<ComboBoxItem Content="Error" />
				</ComboBox>
			</StackPanel>

			<!--  Action Buttons  -->
			<StackPanel
				Height="45"
				Margin="0,5,0,0"
				Background="{StaticResource PanelBackground}"
				Orientation="Horizontal">
				<TextBlock
					Margin="10,0,10,0"
					VerticalAlignment="Center"
					FontWeight="SemiBold"
					Text="Selected Actions:" />
				<Button
					Width="120"
					Height="30"
					Margin="5"
					Click="CopySelected_Click"
					Content="Copy Selected" />
				<Button
					Width="120"
					Height="30"
					Margin="5"
					Click="ExportCSV_Click"
					Content="Export to CSV" />
				<Button
					Width="120"
					Height="30"
					Margin="5"
					Click="ExportText_Click"
					Content="Export to Text" />
				<Button
					Width="100"
					Height="30"
					Margin="5"
					Click="SelectAll_Click"
					Content="Select All"
					Style="{StaticResource SecondaryButton}" />
				<Button
					Width="100"
					Height="30"
					Margin="5"
					Click="DeselectAll_Click"
					Content="Deselect All" />
				<Button
					Width="120"
					Height="30"
					Margin="5"
					Click="DeleteSelected_Click"
					Content="Delete Selected"
					Style="{StaticResource DeleteButton}" />
				<TextBlock
					Name="txtSelectionCount"
					Margin="15,0,10,0"
					VerticalAlignment="Center"
					FontWeight="SemiBold"
					Foreground="{StaticResource PrimaryTurquoise}"
					Text="0 selected" />
			</StackPanel>
		</StackPanel>

		<!--  Activity Log DataGrid with Multi-Select and Context Menu  -->
		<DataGrid
			Name="dgActivities"
			Grid.Row="1"
			Margin="0,0,0,10"
			AutoGenerateColumns="False"
			CanUserResizeColumns="True"
			GridLinesVisibility="Horizontal"
			IsReadOnly="True"
			SelectionChanged="Activities_SelectionChanged"
			SelectionMode="Extended"
			SelectionUnit="FullRow">
			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Click="ContextCopySelected_Click" Header="Copy Selected" />
					<Separator />
					<MenuItem Click="ContextExportCSV_Click" Header="Export Selected to CSV" />
					<MenuItem Click="ContextExportText_Click" Header="Export Selected to Text" />
					<Separator />
					<MenuItem Click="ContextDeleteSelected_Click" Header="Delete Selected" />
					<Separator />
					<MenuItem Click="ContextSelectAll_Click" Header="Select All" />
					<MenuItem Click="ContextClearSelection_Click" Header="Clear Selection" />
				</ContextMenu>
			</DataGrid.ContextMenu>
			<DataGrid.Columns>
				<DataGridTextColumn
					Width="140"
					Binding="{Binding Timestamp, StringFormat='{}{0:MM/dd/yyyy HH:mm:ss}'}"
					Header="Time" />
				<DataGridTextColumn
					Width="150"
					Binding="{Binding JobName}"
					Header="Job Name" />
				<DataGridTemplateColumn Width="80" Header="Level">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Border Padding="5,2" CornerRadius="3">
								<Border.Style>
									<Style TargetType="Border">
										<Style.Triggers>
											<DataTrigger Binding="{Binding Level}" Value="Info">
												<Setter Property="Background" Value="{StaticResource InfoBackground}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding Level}" Value="Success">
												<Setter Property="Background" Value="{StaticResource SuccessBackground}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding Level}" Value="Warning">
												<Setter Property="Background" Value="{StaticResource WarningBackground}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding Level}" Value="Error">
												<Setter Property="Background" Value="{StaticResource ErrorBackground}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<TextBlock
									HorizontalAlignment="Center"
									FontWeight="SemiBold"
									Text="{Binding Level}" />
							</Border>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn
					Width="*"
					Binding="{Binding Message}"
					Header="Message" />
				<DataGridTemplateColumn Width="80" Header="Validation">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock HorizontalAlignment="Center">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Text" Value="?" />
										<Setter Property="Foreground" Value="{StaticResource SuccessText}" />
										<Setter Property="FontWeight" Value="Bold" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding ValidationPassed}" Value="False">
												<Setter Property="Text" Value="?" />
												<Setter Property="Foreground" Value="Red" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>

		<!--  Footer Info  -->
		<Border
			Grid.Row="2"
			Padding="10"
			Background="{StaticResource PanelBackground}"
			BorderBrush="{StaticResource LightBorderBrush}"
			BorderThickness="1">
			<TextBlock
				Name="txtStatus"
				FontSize="12"
				Foreground="{StaticResource SecondaryText}"
				Text="Use Shift+Click or Ctrl+Click to select multiple activities. Right-click for export and delete options." />
		</Border>
	</Grid>
</Window>
