<Window x:Class="BackupUI.Windows.ActivityDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BackupUI.Converters"
        Title="Activity Details"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Controls -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <!-- Title and Refresh -->
            <StackPanel Orientation="Horizontal" Background="{StaticResource PanelBackground}" Height="50">
                <TextBlock Name="txtTitle" 
                           Text="Activity Details" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="15,0,20,0"/>
                <Button Content="Refresh" 
                        Click="Refresh_Click" 
                        Width="100" 
                        Height="32" 
                        Margin="5"/>
                <ComboBox Name="cmbFilterLevel" 
                          Width="140" 
                          Height="32" 
                          Margin="5" 
                          SelectionChanged="FilterLevel_Changed">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Info"/>
                    <ComboBoxItem Content="Success"/>
                    <ComboBoxItem Content="Warning"/>
                    <ComboBoxItem Content="Error"/>
                </ComboBox>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Background="{StaticResource PanelBackground}" Height="45" Margin="0,5,0,0">
                <TextBlock Text="Selected Actions:" 
                           VerticalAlignment="Center" 
                           Margin="10,0,10,0"
                           FontWeight="SemiBold"/>
                <Button Content="Export to CSV" 
                        Click="ExportCSV_Click" 
                        Width="120" 
                        Height="30" 
                        Margin="5"/>
                <Button Content="Export to Text" 
                        Click="ExportText_Click" 
                        Width="120" 
                        Height="30" 
                        Margin="5"/>
                <Button Content="Select All" 
                        Click="SelectAll_Click" 
                        Width="100" 
                        Height="30" 
                        Margin="5"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Content="Deselect All" 
                        Click="DeselectAll_Click" 
                        Width="100" 
                        Height="30" 
                        Margin="5"/>
                <Button Content="Delete Selected" 
                        Click="DeleteSelected_Click" 
                        Width="120" 
                        Height="30" 
                        Margin="5"
                        Style="{StaticResource DeleteButton}"/>
                <TextBlock Name="txtSelectionCount" 
                           Text="0 selected" 
                           VerticalAlignment="Center" 
                           Margin="15,0,10,0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTurquoise}"/>
            </StackPanel>
        </StackPanel>

        <!-- Activity Log DataGrid with Multi-Select and Context Menu -->
        <DataGrid Grid.Row="1" 
                  Name="dgActivities" 
                  Margin="0,0,0,10"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True"
                  SelectionChanged="Activities_SelectionChanged">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Export Selected to CSV" Click="ContextExportCSV_Click"/>
                    <MenuItem Header="Export Selected to Text" Click="ContextExportText_Click"/>
                    <Separator/>
                    <MenuItem Header="Delete Selected" Click="ContextDeleteSelected_Click"/>
                    <Separator/>
                    <MenuItem Header="Select All" Click="ContextSelectAll_Click"/>
                    <MenuItem Header="Clear Selection" Click="ContextClearSelection_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" 
                                    Binding="{Binding Timestamp, StringFormat='{}{0:MM/dd/yyyy HH:mm:ss}'}" 
                                    Width="140"/>
                <DataGridTextColumn Header="Job Name" 
                                    Binding="{Binding JobName}" 
                                    Width="150"/>
                <DataGridTemplateColumn Header="Level" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="5,2" CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Info">
                                                <Setter Property="Background" Value="{StaticResource InfoBackground}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                                <Setter Property="Background" Value="{StaticResource SuccessBackground}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                <Setter Property="Background" Value="{StaticResource WarningBackground}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Background" Value="{StaticResource ErrorBackground}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Level}" 
                                           HorizontalAlignment="Center" 
                                           FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Message" 
                                    Binding="{Binding Message}" 
                                    Width="*"/>
                <DataGridTemplateColumn Header="Validation" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="?"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessText}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ValidationPassed}" Value="False">
                                                <Setter Property="Text" Value="?"/>
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>

    <!-- Footer Info -->
        <Border Grid.Row="2" 
                Background="{StaticResource PanelBackground}" 
                Padding="10" 
                BorderBrush="{StaticResource LightBorderBrush}" 
                BorderThickness="1">
            <TextBlock Name="txtStatus" 
                       Text="Use Shift+Click or Ctrl+Click to select multiple activities. Right-click for export and delete options." 
                       FontSize="12" 
                       Foreground="{StaticResource SecondaryText}"/>
        </Border>
    </Grid>
</Window>
