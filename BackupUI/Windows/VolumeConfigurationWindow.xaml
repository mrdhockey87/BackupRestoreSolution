<Window
	x:Class="SecureServerBackup.Windows.VolumeConfigurationWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Volume Configuration - Interactive Resizing"
	Width="1100"
	Height="650"
	Background="#F5F5F5"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow">

	<Window.Resources>
		<!--  Resizable Volume Style  -->
		<Style x:Key="ResizableVolumeStyle" TargetType="Border">
			<Setter Property="Background" Value="#4CAF50" />
			<Setter Property="BorderBrush" Value="#388E3C" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Cursor" Value="Hand" />
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#66BB6A" />
				</Trigger>
			</Style.Triggers>
		</Style>

		<!--  Non-Resizable Volume Style  -->
		<Style x:Key="NonResizableVolumeStyle" TargetType="Border">
			<Setter Property="Background" Value="#9E9E9E" />
			<Setter Property="BorderBrush" Value="#616161" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Opacity" Value="0.7" />
		</Style>

		<!--  Selected Volume Style  -->
		<Style x:Key="SelectedVolumeStyle" TargetType="Border">
			<Setter Property="Background" Value="#2196F3" />
			<Setter Property="BorderBrush" Value="#1976D2" />
			<Setter Property="BorderThickness" Value="3" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>

		<!--  Resize Handle Style  -->
		<Style x:Key="ResizeHandleStyle" TargetType="Border">
			<Setter Property="Width" Value="16" />
			<Setter Property="Height" Value="80" />
			<Setter Property="Background" Value="#2196F3" />
			<Setter Property="BorderBrush" Value="#1976D2" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Cursor" Value="SizeWE" />
			<Setter Property="Opacity" Value="0.7" />
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Opacity" Value="1.0" />
					<Setter Property="Background" Value="#42A5F5" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<StackPanel Grid.Row="0" Margin="0,0,0,15">
			<TextBlock
				FontSize="24"
				FontWeight="Bold"
				Foreground="{StaticResource SecondaryText}"
				Text="Volume Configuration" />
			<TextBlock
				Name="txtDescription"
				Margin="0,5,0,0"
				FontSize="12"
				Foreground="{StaticResource SecondaryText}"
				Text="Click and drag to resize volumes. Non-resizable volumes are shown in grey."
				TextWrapping="Wrap" />
		</StackPanel>

		<!--  Calculation Progress  -->
		<Border
			Name="pnlCalculating"
			Grid.Row="1"
			Margin="0,0,0,15"
			Padding="15"
			Background="{StaticResource WarningBackground}"
			BorderBrush="#FF9800"
			BorderThickness="2"
			CornerRadius="4"
			Visibility="Visible">
			<StackPanel>
				<TextBlock
					Margin="0,0,0,10"
					HorizontalAlignment="Center"
					FontSize="14"
					FontWeight="SemiBold"
					Text="⚙️ Analyzing disk structure..." />
				<ProgressBar Height="10" IsIndeterminate="True" />
				<TextBlock
					Name="txtCalculatingStatus"
					Margin="0,10,0,0"
					HorizontalAlignment="Center"
					FontSize="11"
					Text="Please wait..." />
			</StackPanel>
		</Border>

		<!--  Main Content Area  -->
		<Grid
			Name="pnlVisualization"
			Grid.Row="2"
			Visibility="Collapsed">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="280" />
			</Grid.ColumnDefinitions>

			<!--  Left Panel - Interactive Disk Visualization  -->
			<Border
				Grid.Column="0"
				Margin="0,0,10,0"
				Padding="20"
				Background="White"
				BorderBrush="#BDBDBD"
				BorderThickness="2"
				CornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  Combined Header - Source Info (small) + Target Info (prominent)  -->
					<Border
						Grid.Row="0"
						Margin="0,0,0,10"
						Padding="10"
						Background="{StaticResource SuccessBackground}"
						BorderBrush="#4CAF50"
						BorderThickness="1"
						CornerRadius="4">
						<Grid>
							<StackPanel Orientation="Vertical">
								<TextBlock
									Name="txtSourceDiskInfo"
									FontSize="11"
									FontWeight="SemiBold"
									Foreground="{StaticResource SecondaryText}"
									Text="Source Disk (4 volumes)" />
								<TextBlock
									Name="txtSourceSize"
									Margin="0,2,0,0"
									FontSize="10"
									Foreground="{StaticResource SecondaryText}"
									Text="Total: 2.11 TB" />
							</StackPanel>
							<StackPanel HorizontalAlignment="Right" Orientation="Vertical">
								<TextBlock
									Name="txtTargetDiskInfo"
									HorizontalAlignment="Right"
									FontSize="13"
									FontWeight="SemiBold"
									Text="Target Disk (Resizable)" />
								<TextBlock
									Name="txtTargetSize"
									Margin="0,2,0,0"
									HorizontalAlignment="Right"
									FontSize="11"
									Text="Total: 1.82 TB" />
							</StackPanel>
						</Grid>
					</Border>

					<!--  Target Disk Canvas (Interactive) - Takes All Available Space  -->
					<Border
						Grid.Row="1"
						Padding="10"
						Background="#FAFAFA"
						BorderBrush="#E0E0E0"
						BorderThickness="1"
						CornerRadius="4">
						<Canvas
							Name="canvasTargetDisk"
							Background="Transparent"
							MouseLeftButtonDown="CanvasTargetDisk_MouseLeftButtonDown"
							MouseLeftButtonUp="CanvasTargetDisk_MouseLeftButtonUp"
							MouseMove="CanvasTargetDisk_MouseMove"
							SizeChanged="CanvasTargetDisk_SizeChanged" />
					</Border>

					<!--  Instructions  -->
					<Border
						Grid.Row="2"
						Margin="0,15,0,0"
						Padding="10"
						Background="{StaticResource InfoBackground}"
						BorderBrush="#2196F3"
						BorderThickness="1"
						CornerRadius="4">
						<StackPanel>
							<TextBlock
								Margin="0,0,0,5"
								FontSize="12"
								FontWeight="Bold"
								Text="💡 How to Use:" />
							<TextBlock
								Margin="15,0,0,2"
								FontSize="11"
								Text="• Click a volume to select it" />
							<TextBlock
								Margin="15,0,0,2"
								FontSize="11"
								Text="• Drag the blue handles (●) between volumes to resize" />
							<TextBlock
								Margin="15,0,0,2"
								FontSize="11"
								Text="• Grey volumes cannot be resized" />
							<TextBlock
								Margin="15,0,0,0"
								FontSize="11"
								Text="• Click 'Reset Layout' to start over" />
						</StackPanel>
					</Border>
				</Grid>
			</Border>

			<!--  Right Panel - Volume Details & Controls  -->
			<Border
				Grid.Column="1"
				Padding="15"
				Background="White"
				BorderBrush="#BDBDBD"
				BorderThickness="2"
				CornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  Volume Details Panel  -->
					<StackPanel Grid.Row="0">
						<TextBlock
							Margin="0,0,0,10"
							FontSize="14"
							FontWeight="Bold"
							Text="Selected Volume" />

						<Border
							Name="pnlVolumeDetails"
							Padding="10"
							Background="#F5F5F5"
							BorderBrush="#BDBDBD"
							BorderThickness="1"
							CornerRadius="4"
							Visibility="Collapsed">
							<StackPanel>
								<TextBlock
									Name="txtSelectedVolume"
									Margin="0,0,0,8"
									FontSize="13"
									FontWeight="SemiBold"
									Text="C: (Local Disk)" />

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<TextBlock
										Grid.Row="0"
										Grid.Column="0"
										Margin="0,2"
										FontSize="11"
										Text="Size:" />
									<TextBlock
										Name="txtVolSize"
										Grid.Row="0"
										Grid.Column="1"
										Margin="0,2"
										HorizontalAlignment="Right"
										FontSize="11"
										FontWeight="SemiBold"
										Text="1.82 TB" />

									<TextBlock
										Grid.Row="1"
										Grid.Column="0"
										Margin="0,2"
										FontSize="11"
										Text="Used:" />
									<TextBlock
										Name="txtVolUsed"
										Grid.Row="1"
										Grid.Column="1"
										Margin="0,2"
										HorizontalAlignment="Right"
										FontSize="11"
										Text="1.01 TB" />

									<TextBlock
										Grid.Row="2"
										Grid.Column="0"
										Margin="0,2"
										FontSize="11"
										Text="Free:" />
									<TextBlock
										Name="txtVolFree"
										Grid.Row="2"
										Grid.Column="1"
										Margin="0,2"
										HorizontalAlignment="Right"
										FontSize="11"
										Text="811 GB" />

									<Separator
										Grid.Row="3"
										Grid.ColumnSpan="2"
										Margin="0,8" />

									<TextBlock
										Grid.Row="4"
										Grid.Column="0"
										Margin="0,2"
										FontSize="11"
										Text="Min Size:" />
									<TextBlock
										Name="txtVolMin"
										Grid.Row="4"
										Grid.Column="1"
										Margin="0,2"
										HorizontalAlignment="Right"
										FontSize="11"
										Foreground="#F44336"
										Text="1.11 TB" />

									<TextBlock
										Grid.Row="5"
										Grid.Column="0"
										Margin="0,2"
										FontSize="11"
										Text="Max Size:" />
									<TextBlock
										Name="txtVolMax"
										Grid.Row="5"
										Grid.Column="1"
										Margin="0,2"
										HorizontalAlignment="Right"
										FontSize="11"
										Foreground="#4CAF50"
										Text="1.82 TB" />
								</Grid>
							</StackPanel>
						</Border>

						<TextBlock
							Name="txtNoSelection"
							Margin="0,20,0,0"
							FontSize="11"
							Foreground="{StaticResource SecondaryText}"
							Text="No volume selected. Click a volume on the target disk to see details."
							TextAlignment="Center"
							TextWrapping="Wrap" />
					</StackPanel>

					<!--  Legend  -->
					<Border
						Grid.Row="1"
						Margin="0,15,0,15"
						Padding="10"
						VerticalAlignment="Top"
						Background="#F5F5F5"
						BorderBrush="#E0E0E0"
						BorderThickness="1"
						CornerRadius="4">
						<StackPanel>
							<TextBlock
								Margin="0,0,0,8"
								FontSize="12"
								FontWeight="Bold"
								Text="Legend" />

							<StackPanel Margin="0,4" Orientation="Horizontal">
								<Border
									Width="24"
									Height="18"
									Margin="0,0,8,0"
									Background="#4CAF50"
									BorderBrush="#388E3C"
									BorderThickness="1"
									CornerRadius="2" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="11"
									Text="Resizable" />
							</StackPanel>

							<StackPanel Margin="0,4" Orientation="Horizontal">
								<Border
									Width="24"
									Height="18"
									Margin="0,0,8,0"
									Background="#9E9E9E"
									BorderBrush="#616161"
									BorderThickness="1"
									CornerRadius="2" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="11"
									Text="Fixed Size" />
							</StackPanel>

							<StackPanel Margin="0,4" Orientation="Horizontal">
								<Border
									Width="24"
									Height="18"
									Margin="0,0,8,0"
									Background="#2196F3"
									BorderBrush="#1976D2"
									BorderThickness="2"
									CornerRadius="2" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="11"
									Text="Selected" />
							</StackPanel>

							<Separator Margin="0,10" />

							<StackPanel Margin="0,4" Orientation="Horizontal">
								<Border
									Width="12"
									Height="18"
									Margin="0,0,8,0"
									Background="#2196F3"
									BorderBrush="#1976D2"
									BorderThickness="1"
									CornerRadius="6" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="11"
									Text="Drag Handle" />
							</StackPanel>
						</StackPanel>
					</Border>

					<!--  Action Buttons  -->
					<StackPanel Grid.Row="2">
						<Button
							Name="btnReset"
							Margin="0,0,0,8"
							Padding="10"
							Click="BtnReset_Click"
							Content="🔄 Reset Layout" />
						<Button
							Name="btnAccept"
							Padding="10"
							Background="#4CAF50"
							BorderBrush="#388E3C"
							Click="BtnAccept_Click"
							Content="✓ Accept Configuration"
							FontWeight="SemiBold"
							Foreground="White"
							IsEnabled="True" />
						<Button
							Name="btnCancel"
							Margin="0,8,0,0"
							Padding="10"
							Click="BtnCancel_Click"
							Content="✕ Cancel" />
					</StackPanel>
				</Grid>
			</Border>
		</Grid>

		<!--  Warning/Error Messages  -->
		<Border
			Name="pnlWarning"
			Grid.Row="3"
			Margin="0,15,0,0"
			Padding="12"
			Background="{StaticResource WarningBackground}"
			BorderBrush="#FF9800"
			BorderThickness="2"
			CornerRadius="4"
			Visibility="Collapsed">
			<StackPanel>
				<TextBlock
					Name="txtWarningTitle"
					Margin="0,0,0,5"
					FontSize="13"
					FontWeight="Bold"
					Foreground="#F57C00"
					Text="⚠️ Warning" />
				<TextBlock
					Name="txtWarningMessage"
					FontSize="11"
					Text=""
					TextWrapping="Wrap" />
			</StackPanel>
		</Border>

		<!--  Status Bar  -->
		<Border
			Grid.Row="4"
			Margin="0,15,0,0"
			Padding="10,8"
			Background="#E0E0E0"
			BorderBrush="#BDBDBD"
			BorderThickness="1,1,1,0"
			CornerRadius="0,0,4,4">
			<Grid>
				<TextBlock
					Name="txtStatus"
					VerticalAlignment="Center"
					FontSize="11"
					Foreground="{StaticResource SecondaryText}"
					Text="Ready. Select a volume to see details." />
				<TextBlock
					Name="txtSpaceInfo"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					FontSize="11"
					Text="Source: 2.11 TB → Target: 1.82 TB (Extra space: 617.67 GB)" />
			</Grid>
		</Border>
	</Grid>
</Window>
