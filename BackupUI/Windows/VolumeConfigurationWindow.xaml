<Window x:Class="BackupUI.Windows.VolumeConfigurationWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Volume Configuration - Interactive Resizing"
Height="650"
Width="1100"
WindowStartupLocation="CenterOwner"
WindowStyle="SingleBorderWindow"
ResizeMode="NoResize"
ShowInTaskbar="False"
Background="#F5F5F5">
    
    <Window.Resources>
        <!-- Resizable Volume Style -->
        <Style x:Key="ResizableVolumeStyle" TargetType="Border">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="BorderBrush" Value="#388E3C"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66BB6A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Non-Resizable Volume Style -->
        <Style x:Key="NonResizableVolumeStyle" TargetType="Border">
            <Setter Property="Background" Value="#9E9E9E"/>
            <Setter Property="BorderBrush" Value="#616161"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- Selected Volume Style -->
        <Style x:Key="SelectedVolumeStyle" TargetType="Border">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <!-- Resize Handle Style -->
        <Style x:Key="ResizeHandleStyle" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1.0"/>
                    <Setter Property="Background" Value="#42A5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Volume Configuration" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Foreground="{StaticResource SecondaryText}"/>
            <TextBlock Name="txtDescription" 
                       Text="Click and drag to resize volumes. Non-resizable volumes are shown in grey." 
                       FontSize="12" 
                       Foreground="{StaticResource SecondaryText}" 
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Calculation Progress -->
        <Border Grid.Row="1" 
                Name="pnlCalculating" 
                Background="{StaticResource WarningBackground}" 
                BorderBrush="#FF9800" 
                BorderThickness="2" 
                CornerRadius="4" 
                Padding="15"
                Margin="0,0,0,15"
                Visibility="Visible">
            <StackPanel>
                <TextBlock Text="⚙️ Analyzing disk structure..." 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <ProgressBar IsIndeterminate="True" Height="10" />
                <TextBlock Name="txtCalculatingStatus" 
                           Text="Please wait..."
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Name="pnlVisualization" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Interactive Disk Visualization -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#BDBDBD" 
                    BorderThickness="2" 
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Combined Header - Source Info (small) + Target Info (prominent) -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource SuccessBackground}" 
                            BorderBrush="#4CAF50" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="10"
                            Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Name="txtSourceDiskInfo"
                                           Text="Source Disk (4 volumes)" 
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryText}"/>
                                <TextBlock Name="txtSourceSize"
                                           Text="Total: 2.11 TB" 
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                                <TextBlock Name="txtTargetDiskInfo"
                                           Text="Target Disk (Resizable)" 
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Name="txtTargetSize"
                                           Text="Total: 1.82 TB" 
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Target Disk Canvas (Interactive) - Takes All Available Space -->
                    <Border Grid.Row="1" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="4"
                            Background="#FAFAFA"
                            Padding="10">
                        <Canvas Name="canvasTargetDisk" 
                                Background="Transparent"
                                SizeChanged="CanvasTargetDisk_SizeChanged"
                                MouseLeftButtonDown="CanvasTargetDisk_MouseLeftButtonDown"
                                MouseMove="CanvasTargetDisk_MouseMove"
                                MouseLeftButtonUp="CanvasTargetDisk_MouseLeftButtonUp"/>
                    </Border>

                    <!-- Instructions -->
                    <Border Grid.Row="2" 
                            Background="{StaticResource InfoBackground}" 
                            BorderBrush="#2196F3" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="10"
                            Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="💡 How to Use:" 
                                       FontWeight="Bold" 
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• Click a volume to select it" 
                                       FontSize="11" 
                                       Margin="15,0,0,2"/>
                            <TextBlock Text="• Drag the blue handles (●) between volumes to resize" 
                                       FontSize="11" 
                                       Margin="15,0,0,2"/>
                            <TextBlock Text="• Grey volumes cannot be resized" 
                                       FontSize="11" 
                                       Margin="15,0,0,2"/>
                            <TextBlock Text="• Click 'Reset Layout' to start over" 
                                       FontSize="11" 
                                       Margin="15,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Panel - Volume Details & Controls -->
            <Border Grid.Column="1" 
                    Background="White" 
                    BorderBrush="#BDBDBD" 
                    BorderThickness="2" 
                    CornerRadius="8"
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Volume Details Panel -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Selected Volume" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>
                        
                        <Border Name="pnlVolumeDetails"
                                Background="#F5F5F5" 
                                BorderBrush="#BDBDBD" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="10"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Name="txtSelectedVolume" 
                                           Text="C: (Local Disk)" 
                                           FontSize="13" 
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Name="txtVolSize" Text="1.82 TB" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2"/>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Used:" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Name="txtVolUsed" Text="1.01 TB" FontSize="11" HorizontalAlignment="Right" Margin="0,2"/>
                                    
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Free:" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Name="txtVolFree" Text="811 GB" FontSize="11" HorizontalAlignment="Right" Margin="0,2"/>
                                    
                                    <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8"/>
                                    
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Min Size:" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Name="txtVolMin" Text="1.11 TB" FontSize="11" Foreground="#F44336" HorizontalAlignment="Right" Margin="0,2"/>
                                    
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Max Size:" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Name="txtVolMax" Text="1.82 TB" FontSize="11" Foreground="#4CAF50" HorizontalAlignment="Right" Margin="0,2"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Name="txtNoSelection"
                                   Text="No volume selected. Click a volume on the target disk to see details."
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,20,0,0"/>
                    </StackPanel>

                    <!-- Legend -->
                    <Border Grid.Row="1" 
                            Background="#F5F5F5" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="10"
                            Margin="0,15,0,15"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Legend" 
                                       FontSize="12" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Background="#4CAF50" 
                                        Width="24" 
                                        Height="18" 
                                        CornerRadius="2"
                                        BorderBrush="#388E3C"
                                        BorderThickness="1"
                                        Margin="0,0,8,0"/>
                                <TextBlock Text="Resizable" 
                                           FontSize="11" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Background="#9E9E9E" 
                                        Width="24" 
                                        Height="18" 
                                        CornerRadius="2"
                                        BorderBrush="#616161"
                                        BorderThickness="1"
                                        Margin="0,0,8,0"/>
                                <TextBlock Text="Fixed Size" 
                                           FontSize="11" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Background="#2196F3" 
                                        Width="24" 
                                        Height="18" 
                                        CornerRadius="2"
                                        BorderBrush="#1976D2"
                                        BorderThickness="2"
                                        Margin="0,0,8,0"/>
                                <TextBlock Text="Selected" 
                                           FontSize="11" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Separator Margin="0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Background="#2196F3" 
                                        Width="12" 
                                        Height="18" 
                                        CornerRadius="6"
                                        BorderBrush="#1976D2"
                                        BorderThickness="1"
                                        Margin="0,0,8,0"/>
                                <TextBlock Text="Drag Handle" 
                                           FontSize="11" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2">
                        <Button Name="btnReset" 
                                Content="🔄 Reset Layout" 
                                Padding="10"
                                Margin="0,0,0,8"
                                Click="BtnReset_Click"/>
                        <Button Name="btnAccept" 
                                Content="✓ Accept Configuration" 
                                Padding="10"
                                Background="#4CAF50"
                                Foreground="White"
                                BorderBrush="#388E3C"
                                FontWeight="SemiBold"
                                IsEnabled="True"
                                Click="BtnAccept_Click"/>
                        <Button Name="btnCancel" 
                                Content="✕ Cancel" 
                                Padding="10"
                                Margin="0,8,0,0"
                                Click="BtnCancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Warning/Error Messages -->
        <Border Grid.Row="3" 
                Name="pnlWarning"
                Background="{StaticResource WarningBackground}" 
                BorderBrush="#FF9800" 
                BorderThickness="2" 
                CornerRadius="4" 
                Padding="12"
                Margin="0,15,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Name="txtWarningTitle" 
                           Text="⚠️ Warning" 
                           FontSize="13" 
                           FontWeight="Bold"
                           Foreground="#F57C00"
                           Margin="0,0,0,5"/>
                <TextBlock Name="txtWarningMessage" 
                           Text="" 
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" 
                Background="#E0E0E0" 
                BorderBrush="#BDBDBD" 
                BorderThickness="1,1,1,0" 
                CornerRadius="0,0,4,4" 
                Padding="10,8"
                Margin="0,15,0,0">
            <Grid>
                <TextBlock Name="txtStatus" 
                           Text="Ready. Select a volume to see details." 
                           FontSize="11"
                           Foreground="{StaticResource SecondaryText}"
                           VerticalAlignment="Center"/>
                <TextBlock Name="txtSpaceInfo"
                           Text="Source: 2.11 TB → Target: 1.82 TB (Extra space: 617.67 GB)" 
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
