<Window
	x:Class="SecureServerBackup.Windows.RestoreItemSelectionWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Select Items to Restore"
	Width="760"
	Height="560"
	MinWidth="620"
	MinHeight="440"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,10">
			<TextBlock FontSize="20" FontWeight="Bold" Text="Select Items to Restore" />
			<TextBlock Name="txtSummary" Margin="0,6,0,0" TextWrapping="Wrap" />
		</StackPanel>

		<GroupBox Grid.Row="1" Header="Backup Contents">
			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<TextBlock
					Name="txtInstructions"
					Margin="0,0,0,10"
					Foreground="{StaticResource SecondaryText}"
					Text="Select the files and folders to restore from this restore point."
					TextWrapping="Wrap" />

				<ListBox
					Name="lstBackupItems"
					Grid.Row="1"
					SelectionMode="Multiple" />
			</Grid>
		</GroupBox>

		<StackPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
			<Button Width="90" Margin="0,0,8,0" Click="Cancel_Click" Content="Cancel" />
			<Button Name="btnNext" Width="110" Click="Next_Click" Content="Next" />
		</StackPanel>
	</Grid>
</Window>