<Window
    x:Class="SecureServerBackup.Windows.BackupCompletionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Backup Complete"
    MinWidth="400"
    MaxWidth="600"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#F5FFFF" />
        <SolidColorBrush x:Key="HeaderBackground" Color="#B0E0E6" />
        <SolidColorBrush x:Key="BorderColor" Color="#20B2AA" />
        <SolidColorBrush x:Key="ButtonBackground" Color="#008B8B" />
        <SolidColorBrush x:Key="ButtonHover" Color="#20B2AA" />

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#008080" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Background="{StaticResource WindowBackground}"
        BorderBrush="{StaticResource BorderColor}"
        BorderThickness="2"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border
                Grid.Row="0"
                Background="{StaticResource HeaderBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                CornerRadius="3,3,0,0">
                <TextBlock
                    x:Name="txtTitle"
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="Black"
                    Text="Backup Complete" />
            </Border>

            <!--  Content  -->
            <Grid Grid.Row="1" Margin="20,15,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="txtIcon"
                    Grid.Column="0"
                    Margin="0,0,15,0"
                    VerticalAlignment="Top"
                    FontSize="28"
                    Text="✅" />

                <TextBox
                    x:Name="txtMessage"
                    Grid.Column="1"
                    MinWidth="280"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="14"
                    Foreground="Black"
                    HorizontalScrollBarVisibility="Disabled"
                    IsReadOnly="True"
                    IsTabStop="False"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>

            <!--  Countdown  -->
            <TextBlock
                x:Name="txtCountdown"
                Grid.Row="2"
                Margin="20,0,20,10"
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="Gray"
                Text="This dialog will close automatically in 15:00" />

            <!--  Buttons  -->
            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="btnOk"
                    Click="BtnOk_Click"
                    Content="OK"
                    Style="{StaticResource DialogButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
