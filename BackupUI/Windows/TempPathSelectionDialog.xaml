<Window x:Class="BackupUI.Windows.TempPathSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Temporary Path for Mount"
        Width="550"
        Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}"
        BorderBrush="{StaticResource LightBorderBrush}"
        BorderThickness="1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" FontWeight="Bold" Text="Temporary Path for Mount Operation" Margin="0,0,0,15" />
        
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,10">
            <Run Text="The WIM API requires a temporary directory to decompress and process backup image data during mount operations."/>
            <LineBreak/><LineBreak/>
            <Run Text="Choose a location with adequate free space (several GB may be needed for large backups)."/>
        </TextBlock>

        <Label Grid.Row="2" Content="Temporary Path:" Margin="0,5,0,5" />

        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Name="txtTempPath" Padding="5" VerticalContentAlignment="Center" IsReadOnly="True" Background="{StaticResource PanelBackground}" />
            <Button Grid.Column="1" Content="Browse..." Width="80" Height="28" Margin="10,0,0,0" Click="Browse_Click" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,0,0,15">
            <TextBlock Name="txtSpaceInfo" Foreground="{StaticResource SecondaryText}" FontSize="12" Text="Checking available space..." />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Height="28" Margin="0,0,10,0" IsDefault="True" Click="OK_Click" />
            <Button Content="Cancel" Width="80" Height="28" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>