<Window
	x:Class="SecureServerBackup.Windows.NetworkPathDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Add Network Path"
	Width="500"
	Height="219"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock
			Grid.Row="0"
			Margin="0,0,0,10"
			FontWeight="Bold"
			Text="Enter Network Path (UNC Format):" />

		<TextBox
			x:Name="txtNetworkPath"
			Grid.Row="1"
			Height="30"
			Margin="0,0,0,10"
			VerticalContentAlignment="Center"
			FontSize="14"
			Text="\\" />

		<TextBlock
			Grid.Row="2"
			Margin="0,0,0,10"
			Foreground="Gray"
			TextWrapping="Wrap">
			<Run Text="Examples:" />
			<LineBreak />
			<Run Text="  \\server\share" />
			<LineBreak />
			<Run Text="  \\192.168.1.100\backups" />
			<LineBreak />
			<Run Text="  \\NAS\Documents" />
		</TextBlock>

		<StackPanel
			Grid.Row="4"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				Width="80"
				Height="30"
				Margin="0,0,10,0"
				Click="OK_Click"
				Content="OK"
				IsDefault="True" />
			<Button
				Width="80"
				Height="30"
				Click="Cancel_Click"
				Content="Cancel"
				IsCancel="True" />
		</StackPanel>
	</Grid>
</Window>
