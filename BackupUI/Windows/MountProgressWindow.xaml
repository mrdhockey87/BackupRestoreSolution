<Window
	x:Class="BackupUI.Windows.MountProgressWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Mounting Backup"
	Width="450"
	Height="200"
	Background="{StaticResource WindowBackground}"
	BorderBrush="{StaticResource LightBorderBrush}"
	BorderThickness="1"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner"
	WindowStyle="None">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Title  -->
		<TextBlock
			Grid.Row="0"
			Margin="0,0,0,15"
			FontSize="16"
			FontWeight="Bold"
			Text="Mounting Backup..." />

		<!--  Backup Name  -->
		<TextBlock
			Name="txtBackupName"
			Grid.Row="1"
			Margin="0,0,0,10"
			FontSize="14"
			Text="Backup: Loading..." />

		<!--  Progress Bar  -->
		<ProgressBar
			Name="progressBar"
			Grid.Row="2"
			Height="25"
			Margin="0,0,0,15"
			Foreground="{StaticResource MediumTurquoise}"
			IsIndeterminate="True" />

		<!--  Status Message  -->
		<TextBlock
			Name="txtStatus"
			Grid.Row="3"
			VerticalAlignment="Top"
			FontSize="12"
			Foreground="{StaticResource SecondaryText}"
			Text="Opening SSB archive..."
			TextWrapping="Wrap" />

		<!--  Current File Being Processed (v6.0.1.19)  -->
		<TextBlock
			Name="txtCurrentFile"
			Grid.Row="3"
			Margin="0,0,0,5"
			VerticalAlignment="Bottom"
			FontSize="10"
			Foreground="Gray"
			Text=""
			TextTrimming="CharacterEllipsis"
			TextWrapping="Wrap" />
	</Grid>
</Window>
