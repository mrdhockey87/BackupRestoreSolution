<Window x:Class="SecureServerBackup.Windows.NextRunTimeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Next Run Time"
        Width="460"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}"
        BorderBrush="{StaticResource LightBorderBrush}"
        BorderThickness="1">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock Grid.Row="0"
				   Text="Edit Next Run Time"
				   FontSize="16"
				   FontWeight="Bold"
				   Margin="0,0,0,12" />
		<StackPanel Grid.Row="1"
					Margin="0,0,0,12">
			<TextBlock Name="txtCurrentRun"
					   Foreground="{StaticResource SecondaryText}"
					   Margin="0,0,0,4" />
			<TextBlock Name="txtLatestAllowed"
                      Foreground="{StaticResource SecondaryText}"
					   Margin="0,0,0,4" />
			<TextBlock Name="txtOneTimeNotice"
					   TextWrapping="Wrap"
					   Foreground="{StaticResource SecondaryText}" />
		</StackPanel>
		<Grid Grid.Row="2"
			  Margin="0,0,0,12">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Row="0"
					   Grid.Column="0"
                     Text="Month"
					   Margin="0,0,10,4" />
			<TextBlock Grid.Row="0"
					   Grid.Column="1"
                    Text="Day"
					   Margin="0,0,10,4" />
			<TextBlock Grid.Row="0"
					   Grid.Column="2"
                      Text="Year"
					   Margin="0,0,0,4" />
			<ComboBox Grid.Row="1"
					  Grid.Column="0"
                      Name="cmbMonth"
					  Margin="0,0,10,0"
					  SelectionChanged="DateTimePart_SelectionChanged" />
			<ComboBox Grid.Row="1"
					  Grid.Column="1"
                     Name="cmbDay"
					  Margin="0,0,10,0"
					  SelectionChanged="DateTimePart_SelectionChanged" />
			<ComboBox Grid.Row="1"
					  Grid.Column="2"
                   Name="cmbYear"
					  SelectionChanged="DateTimePart_SelectionChanged" />
		</Grid>
		<Grid Grid.Row="3"
			  Margin="0,0,0,12">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Row="0"
					   Grid.Column="0"
					   Text="Hour"
					   Margin="0,0,10,4" />
			<TextBlock Grid.Row="0"
					   Grid.Column="1"
					   Text="Minute"
					   Margin="0,0,10,4" />
			<TextBlock Grid.Row="0"
					   Grid.Column="2"
					   Text="AM/PM"
					   Margin="0,0,0,4" />
			<ComboBox Grid.Row="1"
					  Grid.Column="0"
					  Name="cmbHour"
					  Margin="0,0,10,0"
					  SelectionChanged="DateTimePart_SelectionChanged" />
			<ComboBox Grid.Row="1"
					  Grid.Column="1"
					  Name="cmbMinute"
					  Margin="0,0,10,0"
					  SelectionChanged="DateTimePart_SelectionChanged" />
			<ComboBox Grid.Row="1"
					  Grid.Column="2"
					  Name="cmbPeriod"
					  SelectionChanged="DateTimePart_SelectionChanged" />
		</Grid>
		<Border Grid.Row="4"
				Margin="0,0,0,16"
				Padding="10"
				Background="{StaticResource PanelBackground}"
				BorderBrush="{StaticResource LightBorderBrush}"
				BorderThickness="1">
			<TextBlock Name="txtSelectedValue"
					   FontWeight="SemiBold" />
		</Border>
		<StackPanel Grid.Row="5"
					Orientation="Horizontal"
					HorizontalAlignment="Right">
			<Button Content="Save"
					Width="90"
					Margin="0,0,10,0"
					IsDefault="True"
					Click="Save_Click" />
			<Button Content="Cancel"
					Width="90"
					IsCancel="True"
                  Click="Cancel_Click" />
		</StackPanel>
	</Grid>
</Window>
