<Window
	x:Class="SecureServerBackup.Windows.RestorePointSelectionWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Select Restore Point"
	Width="760"
	Height="520"
	MinWidth="620"
	MinHeight="420"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,10">
			<TextBlock FontSize="20" FontWeight="Bold" Text="Select Restore Point" />
			<TextBlock Name="txtBackupSummary" Margin="0,6,0,0" TextWrapping="Wrap" />
		</StackPanel>

		<GroupBox Grid.Row="1" Header="Available Restore Points">
			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<TextBlock
					Name="txtRestorePointHelp"
					Margin="0,0,0,10"
					Foreground="{StaticResource SecondaryText}"
					Text="Select the backup date/time restore point to continue."
					TextWrapping="Wrap" />

				<ListBox
					Name="lstRestorePoints"
					Grid.Row="1"
					SelectionMode="Single">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Padding="4" Background="Transparent">
								<StackPanel Orientation="Horizontal">
									<CheckBox
										Margin="0,0,8,0"
										VerticalAlignment="Top"
										Focusable="False"
										IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=OneWay}"
										IsHitTestVisible="False" />
									<StackPanel>
										<TextBlock FontWeight="Bold" Text="{Binding DisplayName}" />
										<TextBlock
											FontSize="10"
											Foreground="{StaticResource SecondaryText}"
											Text="{Binding Description}" />
									</StackPanel>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</GroupBox>

		<StackPanel Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
			<Button Width="90" Margin="0,0,8,0" Click="Cancel_Click" Content="Cancel" />
			<Button Name="btnNext" Width="110" Click="Next_Click" Content="Next" />
		</StackPanel>
	</Grid>
</Window>