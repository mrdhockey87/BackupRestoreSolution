<Window
	x:Class="SecureServerBackup.Windows.BackupWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Create Backup"
	Width="900"
	Height="700"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock
			Grid.Row="0"
			Margin="0,0,0,20"
			FontSize="20"
			FontWeight="Bold"
			Text="Create Backup" />

		<TabControl Grid.Row="1">
			<TabItem Header="General">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="10">
						<TextBlock Margin="0,0,0,5" Text="Backup Name:" />
						<TextBox
							Name="txtBackupName"
							Height="25"
							Margin="0,0,0,15" />

						<TextBlock Margin="0,0,0,5" Text="Backup Type:" />
						<ComboBox
							Name="cmbBackupType"
							Height="25"
							Margin="0,0,0,15"
							SelectionChanged="BackupType_SelectionChanged" />

						<TextBlock Margin="0,0,0,5" Text="What to Backup:" />
						<ComboBox
							Name="cmbBackupTarget"
							Height="25"
							Margin="0,0,0,15"
							SelectionChanged="BackupTarget_SelectionChanged" />

						<StackPanel
							Name="pnlDiskSelection"
							Margin="0,0,0,15"
							Visibility="Collapsed">
							<TextBlock Margin="0,0,0,5" Text="Select Disk:" />
							<ComboBox Name="cmbDisks" Height="25" />
						</StackPanel>

						<StackPanel
							Name="pnlVolumeSelection"
							Margin="0,0,0,15"
							Visibility="Collapsed">
							<TextBlock Margin="0,0,0,5" Text="Select Volume:" />
							<ListBox
								Name="lstVolumes"
								Height="150"
								SelectionMode="Multiple" />
						</StackPanel>

						<StackPanel
							Name="pnlFileSelection"
							Margin="0,0,0,15"
							Visibility="Collapsed">
							<TextBlock Margin="0,0,0,5" Text="Files and Folders:" />
							<ListBox Name="lstFiles" Height="150" />
							<StackPanel Margin="0,5,0,0" Orientation="Horizontal">
								<Button
									Width="100"
									Margin="0,0,5,0"
									Click="AddFiles_Click"
									Content="Add Files..." />
								<Button
									Width="100"
									Margin="0,0,5,0"
									Click="AddFolder_Click"
									Content="Add Folder..." />
								<Button
									Width="100"
									Click="RemoveItem_Click"
									Content="Remove" />
							</StackPanel>
						</StackPanel>

						<CheckBox
							Name="chkHyperV"
							Margin="0,0,0,15"
							Checked="HyperV_CheckedChanged"
							Content="Backup Hyper-V Virtual Machines"
							Unchecked="HyperV_CheckedChanged" />

						<StackPanel
							Name="pnlHyperV"
							Margin="0,0,0,15"
							Visibility="Collapsed">
							<TextBlock Margin="0,0,0,5" Text="Select Virtual Machines:" />
							<ListBox
								Name="lstHyperVMachines"
								Height="150"
								SelectionMode="Multiple" />
							<Button
								Width="100"
								Margin="0,5,0,0"
								HorizontalAlignment="Left"
								Click="RefreshHyperV_Click"
								Content="Refresh VMs" />
						</StackPanel>

						<TextBlock Margin="0,0,0,5" Text="Backup Destination:" />
						<Grid Margin="0,0,0,15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBox
								Name="txtDestination"
								Grid.Column="0"
								Height="25"
								Margin="0,0,5,0" />
							<Button
								Grid.Column="1"
								Width="80"
								Click="BrowseDestination_Click"
								Content="Browse..." />
						</Grid>

						<CheckBox
							Name="chkIncludeSystemState"
							Margin="0,0,0,10"
							Content="Include System State (for boot volumes)" />
						<CheckBox
							Name="chkCompress"
							Margin="0,0,0,10"
							Content="Compress backup data"
							IsChecked="True" />
						<CheckBox
							Name="chkVerify"
							Margin="0,0,0,10"
							Content="Verify backup after completion"
							IsChecked="True" />
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<TabItem Header="Schedule">
				<StackPanel Margin="10">
					<CheckBox
						Name="chkEnableSchedule"
						Margin="0,0,0,15"
						Checked="Schedule_CheckedChanged"
						Content="Enable Scheduled Backup"
						Unchecked="Schedule_CheckedChanged" />

					<StackPanel Name="pnlSchedule" IsEnabled="False">
						<TextBlock Margin="0,0,0,5" Text="Frequency:" />
						<ComboBox
							Name="cmbFrequency"
							Height="25"
							Margin="0,0,0,15"
							SelectionChanged="Frequency_SelectionChanged" />

						<TextBlock Margin="0,0,0,5" Text="Time:" />
						<StackPanel Margin="0,0,0,15" Orientation="Horizontal">
							<ComboBox
								Name="cmbHour"
								Width="60"
								Margin="0,0,5,0" />
							<TextBlock
								Margin="0,0,5,0"
								VerticalAlignment="Center"
								Text=":" />
							<ComboBox Name="cmbMinute" Width="60" />
						</StackPanel>

						<StackPanel
							Name="pnlWeekly"
							Margin="0,0,0,15"
							Visibility="Collapsed">
							<TextBlock Margin="0,0,0,5" Text="Days of Week:" />
							<StackPanel>
								<CheckBox Name="chkMonday" Content="Monday" />
								<CheckBox Name="chkTuesday" Content="Tuesday" />
								<CheckBox Name="chkWednesday" Content="Wednesday" />
								<CheckBox Name="chkThursday" Content="Thursday" />
								<CheckBox Name="chkFriday" Content="Friday" />
								<CheckBox Name="chkSaturday" Content="Saturday" />
								<CheckBox Name="chkSunday" Content="Sunday" />
							</StackPanel>
						</StackPanel>

						<StackPanel
							Name="pnlMonthly"
							Margin="0,0,0,15"
							Visibility="Collapsed">
							<TextBlock Margin="0,0,0,5" Text="Day of Month:" />
							<ComboBox
								Name="cmbDayOfMonth"
								Width="60"
								HorizontalAlignment="Left" />
						</StackPanel>
					</StackPanel>
				</StackPanel>
			</TabItem>
		</TabControl>

		<ProgressBar
			Name="progressBar"
			Grid.Row="2"
			Height="20"
			Margin="0,10,0,10"
			Visibility="Collapsed" />
		<TextBlock
			Name="txtProgress"
			Grid.Row="2"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Visibility="Collapsed" />

		<StackPanel
			Grid.Row="3"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				Width="100"
				Margin="0,0,5,0"
				Click="StartBackup_Click"
				Content="Start Backup" />
			<Button
				Width="100"
				Margin="0,0,5,0"
				Click="SaveJob_Click"
				Content="Save Job" />
			<Button
				Width="100"
				Click="Cancel_Click"
				Content="Cancel" />
		</StackPanel>
	</Grid>
</Window>
