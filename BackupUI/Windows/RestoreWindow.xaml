<Window
	x:Class="SecureServerBackup.Windows.RestoreWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Restore from Backup"
	Width="1000"
	Height="750"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock
			Grid.Row="0"
			Margin="0,0,0,15"
			FontSize="20"
			FontWeight="Bold"
			Text="Restore from Backup" />

		<!--  Main Content: Three-Step Wizard  -->
		<Grid Grid.Row="1">
			<!--  Step 1: Select Backup & Date  -->
			<Grid Name="pnlStep1" Visibility="Visible">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					Margin="0,0,0,15"
					FontSize="16"
					FontWeight="Bold"
					Text="Step 1: Select Backup and Date" />

				<GroupBox
					Grid.Row="1"
					Margin="0,0,0,15"
					Header="Backup Source">
					<StackPanel Margin="10">
						<TextBlock Margin="0,0,0,5" Text="Select backup file or folder:" />
						<Grid Margin="0,0,0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBox
								Name="txtBackupSource"
								Grid.Column="0"
								Height="25"
								Margin="0,0,5,0" />
							<Button
								Grid.Column="1"
								Width="80"
								Click="BrowseBackup_Click"
								Content="Browse..." />
						</Grid>

						<Button
							Width="120"
							HorizontalAlignment="Left"
							Click="LoadBackup_Click"
							Content="Load Backup" />
					</StackPanel>
				</GroupBox>

				<GroupBox
					Grid.Row="2"
					Margin="0,0,0,15"
					Header="Available Backup Dates">
					<Grid Margin="10">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<TextBlock
							Name="txtBackupInfo"
							Grid.Row="0"
							Margin="0,0,0,10"
							FontStyle="Italic"
							Foreground="{StaticResource SecondaryText}"
							TextWrapping="Wrap" />

						<ListBox
							Name="lstBackupDates"
							Grid.Row="1"
							SelectionMode="Single">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<TextBlock
											Width="200"
											FontWeight="Bold"
											Text="{Binding DisplayDate}" />
										<TextBlock
											Width="150"
											Foreground="Blue"
											Text="{Binding BackupType}" />
										<TextBlock Foreground="Gray" Text="{Binding Size}" />
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>
				</GroupBox>

				<StackPanel
					Grid.Row="3"
					HorizontalAlignment="Right"
					Orientation="Horizontal">
					<Button
						Width="100"
						Click="Step1Next_Click"
						Content="Next &gt;" />
				</StackPanel>
			</Grid>

			<!--  Step 2: Select What to Restore  -->
			<Grid Name="pnlStep2" Visibility="Collapsed">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					Margin="0,0,0,15"
					FontSize="16"
					FontWeight="Bold"
					Text="Step 2: Select What to Restore" />

				<GroupBox
					Grid.Row="1"
					Margin="0,0,0,15"
					Header="Backup Contents">
					<Grid Margin="5">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock
							Grid.Row="0"
							Margin="0,0,0,10"
							FontSize="11"
							Foreground="{StaticResource SecondaryText}"
							TextWrapping="Wrap">
							Check drives, volumes, or expand to select specific files and folders to restore.
						</TextBlock>

						<TreeView
							Name="treeRestoreContents"
							Grid.Row="1"
							BorderBrush="{StaticResource LightBorderBrush}"
							BorderThickness="1" />

						<StackPanel
							Grid.Row="2"
							Margin="0,10,0,0"
							Orientation="Horizontal">
							<Button
								Width="100"
								Margin="0,0,5,0"
								Click="ExpandAll_Click"
								Content="Expand All" />
							<Button
								Width="100"
								Click="CollapseAll_Click"
								Content="Collapse All" />
							<Button
								Width="100"
								Margin="5,0,0,0"
								Click="SelectAll_Click"
								Content="Select All" />
							<Button
								Width="100"
								Margin="5,0,0,0"
								Click="UnselectAll_Click"
								Content="Unselect All" />
						</StackPanel>
					</Grid>
				</GroupBox>

				<StackPanel
					Grid.Row="2"
					HorizontalAlignment="Right"
					Orientation="Horizontal">
					<Button
						Width="100"
						Margin="0,0,5,0"
						Click="Step2Back_Click"
						Content="&lt; Back" />
					<Button
						Width="100"
						Click="Step2Next_Click"
						Content="Next &gt;" />
				</StackPanel>
			</Grid>

			<!--  Step 3: Select Restore Destination  -->
			<Grid Name="pnlStep3" Visibility="Collapsed">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					Margin="0,0,0,15"
					FontSize="16"
					FontWeight="Bold"
					Text="Step 3: Select Restore Destination" />

				<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="0,0,0,15">
						<GroupBox Header="Restore Location">
							<StackPanel Margin="10">
								<RadioButton
									Name="rbOriginalLocation"
									Margin="0,0,0,10"
									Checked="RestoreLocation_Changed"
									Content="Restore to original location"
									GroupName="RestoreLocation"
									IsChecked="True" />
								<RadioButton
									Name="rbNewLocation"
									Margin="0,0,0,10"
									Checked="RestoreLocation_Changed"
									Content="Restore to new location"
									GroupName="RestoreLocation" />

								<StackPanel
									Name="pnlNewLocation"
									Margin="20,0,0,0"
									Visibility="Collapsed">
									<TextBlock Margin="0,0,0,5" Text="New Restore Path:" />
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBox
											Name="txtRestoreDestination"
											Grid.Column="0"
											Height="25"
											Margin="0,0,5,0" />
										<Button
											Grid.Column="1"
											Width="80"
											Click="BrowseDestination_Click"
											Content="Browse..." />
									</Grid>
								</StackPanel>
							</StackPanel>
						</GroupBox>

						<GroupBox Margin="0,15,0,0" Header="Restore Options">
							<StackPanel Margin="10">
								<CheckBox
									Name="chkOverwrite"
									Margin="0,0,0,10"
									Content="Overwrite existing files"
									IsChecked="True" />
								<CheckBox
									Name="chkPreservePermissions"
									Margin="0,0,0,10"
									Content="Preserve file permissions and ownership"
									IsChecked="True" />
								<CheckBox
									Name="chkRestoreSystemState"
									Margin="0,0,0,10"
									Content="Restore System State (if backed up)" />
							</StackPanel>
						</GroupBox>

						<GroupBox Margin="0,15,0,0" Header="Advanced Options">
							<StackPanel Margin="10">
								<CheckBox
									Name="chkRestoreAsHyperV"
									Margin="0,0,0,10"
									Checked="HyperV_CheckedChanged"
									Content="Restore as Hyper-V Virtual Machine"
									Unchecked="HyperV_CheckedChanged" />

								<StackPanel
									Name="pnlHyperV"
									Margin="20,0,0,0"
									Visibility="Collapsed">
									<TextBlock Margin="0,0,0,5" Text="VM Name:" />
									<TextBox
										Name="txtVMName"
										Height="25"
										Margin="0,0,0,10" />

									<TextBlock Margin="0,0,0,5" Text="VM Storage Path:" />
									<Grid Margin="0,0,0,10">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBox
											Name="txtVMStorage"
											Grid.Column="0"
											Height="25"
											Margin="0,0,5,0" />
										<Button
											Grid.Column="1"
											Width="80"
											Click="BrowseVMStorage_Click"
											Content="Browse..." />
									</Grid>

									<CheckBox Name="chkStartVM" Content="Start VM after restore" />
								</StackPanel>
							</StackPanel>
						</GroupBox>
					</StackPanel>
				</ScrollViewer>

				<StackPanel
					Grid.Row="2"
					HorizontalAlignment="Right"
					Orientation="Horizontal">
					<Button
						Width="100"
						Margin="0,0,5,0"
						Click="Step3Back_Click"
						Content="&lt; Back" />
					<Button
						Width="120"
						Click="StartRestore_Click"
						Content="Start Restore" />
				</StackPanel>
			</Grid>
		</Grid>

		<!--  Progress Bar  -->
		<ProgressBar
			Name="progressBar"
			Grid.Row="2"
			Height="20"
			Margin="0,10,0,10"
			Visibility="Collapsed" />
		<TextBlock
			Name="txtProgress"
			Grid.Row="2"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Visibility="Collapsed" />

		<!--  Action Buttons  -->
		<StackPanel
			Grid.Row="3"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				Width="100"
				Click="Cancel_Click"
				Content="Cancel" />
		</StackPanel>
	</Grid>
</Window>
