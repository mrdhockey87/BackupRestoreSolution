<Window x:Class="BackupUI.Windows.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore from Backup"
        Height="750"
        Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Restore from Backup" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Main Content: Three-Step Wizard -->
        <Grid Grid.Row="1">
            <!-- Step 1: Select Backup & Date -->
            <Grid Name="pnlStep1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Step 1: Select Backup and Date" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                <GroupBox Grid.Row="1" Header="Backup Source" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <TextBlock Text="Select backup file or folder:" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtBackupSource" Grid.Column="0" Height="25" Margin="0,0,5,0"/>
                            <Button Grid.Column="1" Content="Browse..." Width="80" Click="BrowseBackup_Click"/>
                        </Grid>
                        
                        <Button Content="Load Backup" Width="120" HorizontalAlignment="Left" Click="LoadBackup_Click"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Available Backup Dates" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Name="txtBackupInfo" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="#666" FontStyle="Italic"/>
                        
                        <ListBox Grid.Row="1" Name="lstBackupDates" SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayDate}" FontWeight="Bold" Width="200"/>
                                        <TextBlock Text="{Binding BackupType}" Foreground="Blue" Width="150"/>
                                        <TextBlock Text="{Binding Size}" Foreground="Gray"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </GroupBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Next &gt;" Width="100" Click="Step1Next_Click"/>
                </StackPanel>
            </Grid>

            <!-- Step 2: Select What to Restore -->
            <Grid Name="pnlStep2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Step 2: Select What to Restore" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                <GroupBox Grid.Row="1" Header="Backup Contents" Margin="0,0,0,15">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,0,0,10">
                            Check drives, volumes, or expand to select specific files and folders to restore.
                        </TextBlock>

                        <TreeView Grid.Row="1" Name="treeRestoreContents" BorderBrush="#CCC" BorderThickness="1"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Expand All" Width="100" Margin="0,0,5,0" Click="ExpandAll_Click"/>
                            <Button Content="Collapse All" Width="100" Click="CollapseAll_Click"/>
                            <Button Content="Select All" Width="100" Margin="5,0,0,0" Click="SelectAll_Click"/>
                            <Button Content="Unselect All" Width="100" Margin="5,0,0,0" Click="UnselectAll_Click"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt; Back" Width="100" Margin="0,0,5,0" Click="Step2Back_Click"/>
                    <Button Content="Next &gt;" Width="100" Click="Step2Next_Click"/>
                </StackPanel>
            </Grid>

            <!-- Step 3: Select Restore Destination -->
            <Grid Name="pnlStep3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Step 3: Select Restore Destination" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,15">
                        <GroupBox Header="Restore Location">
                            <StackPanel Margin="10">
                                <RadioButton Name="rbOriginalLocation" Content="Restore to original location" 
                                           GroupName="RestoreLocation" IsChecked="True" Margin="0,0,0,10"
                                           Checked="RestoreLocation_Changed"/>
                                <RadioButton Name="rbNewLocation" Content="Restore to new location" 
                                           GroupName="RestoreLocation" Margin="0,0,0,10"
                                           Checked="RestoreLocation_Changed"/>

                                <StackPanel Name="pnlNewLocation" Visibility="Collapsed" Margin="20,0,0,0">
                                    <TextBlock Text="New Restore Path:" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Name="txtRestoreDestination" Grid.Column="0" Height="25" Margin="0,0,5,0"/>
                                        <Button Grid.Column="1" Content="Browse..." Width="80" Click="BrowseDestination_Click"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Restore Options" Margin="0,15,0,0">
                            <StackPanel Margin="10">
                                <CheckBox Name="chkOverwrite" Content="Overwrite existing files" IsChecked="True" Margin="0,0,0,10"/>
                                <CheckBox Name="chkPreservePermissions" Content="Preserve file permissions and ownership" IsChecked="True" Margin="0,0,0,10"/>
                                <CheckBox Name="chkRestoreSystemState" Content="Restore System State (if backed up)" Margin="0,0,0,10"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Advanced Options" Margin="0,15,0,0">
                            <StackPanel Margin="10">
                                <CheckBox Name="chkRestoreAsHyperV" Content="Restore as Hyper-V Virtual Machine" 
                                        Margin="0,0,0,10" Checked="HyperV_CheckedChanged" Unchecked="HyperV_CheckedChanged"/>

                                <StackPanel Name="pnlHyperV" Visibility="Collapsed" Margin="20,0,0,0">
                                    <TextBlock Text="VM Name:" Margin="0,0,0,5"/>
                                    <TextBox Name="txtVMName" Height="25" Margin="0,0,0,10"/>

                                    <TextBlock Text="VM Storage Path:" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Name="txtVMStorage" Grid.Column="0" Height="25" Margin="0,0,5,0"/>
                                        <Button Grid.Column="1" Content="Browse..." Width="80" Click="BrowseVMStorage_Click"/>
                                    </Grid>

                                    <CheckBox Name="chkStartVM" Content="Start VM after restore"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&lt; Back" Width="100" Margin="0,0,5,0" Click="Step3Back_Click"/>
                    <Button Content="Start Restore" Width="120" Click="StartRestore_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="2" Name="progressBar" Height="20" Margin="0,10,0,10" Visibility="Collapsed"/>
        <TextBlock Grid.Row="2" Name="txtProgress" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
