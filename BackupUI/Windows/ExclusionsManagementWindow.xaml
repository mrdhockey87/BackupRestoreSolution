<Window x:Class="BackupUI.ExclusionsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Backup Exclusions" 
        Height="800" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}">
    
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- System Exclusions (Read-Only) -->
        <GroupBox Header="System Exclusions (Non-Editable)" Grid.Row="0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" 
                           Foreground="{StaticResource SecondaryText}">
                    These items are automatically excluded to prevent backup failures and cannot be modified:
                </TextBlock>
                
                <TextBlock Margin="10,5" FontFamily="Consolas" FontSize="11">
                    • System Volume Information (Access denied)
                </TextBlock>
                <TextBlock Margin="10,5" FontFamily="Consolas" FontSize="11">
                    • $RECYCLE.BIN (Recycle bin)
                </TextBlock>
                <TextBlock Margin="10,5" FontFamily="Consolas" FontSize="11">
                    • pagefile.sys (Windows page file - always locked)
                </TextBlock>
                <TextBlock Margin="10,5" FontFamily="Consolas" FontSize="11">
                    • swapfile.sys (Windows swap file - always locked)
                </TextBlock>
                <TextBlock Margin="10,5" FontFamily="Consolas" FontSize="11">
                    • hiberfil.sys (Hibernation file - always locked)
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <!-- Add Exclusions Section -->
        <GroupBox Header="Add Custom Exclusions" Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- File/Folder Browsing -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Browse for File..." Click="BrowseFile_Click" Width="130"/>
                    <Button Content="Browse for Folder..." Click="BrowseFolder_Click" Width="130"/>
                </StackPanel>

                <!-- Extension Entry -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                    <Label Content="Or enter file extension pattern (e.g., *.tmp, *.log):"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtExtensionPattern" Grid.Column="0" 
                                 VerticalContentAlignment="Center"
                                 Padding="5"
                                 KeyDown="TxtExtensionPattern_KeyDown"/>
                        <Button Grid.Column="1" Content="Add Pattern" Click="AddPattern_Click" Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Current User Exclusions List -->
        <GroupBox Header="Current Custom Exclusions" Grid.Row="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="lstExclusions" 
                         Grid.Row="0"
                         SelectionMode="Extended"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Icon indicating type -->
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding Icon}" 
                                           FontSize="16" 
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                
                                <!-- Path or pattern -->
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding Path}" 
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="txtNoExclusions"
                           Grid.Row="0"
                           Text="No custom exclusions defined. Add files, folders, or patterns above."
                           Foreground="{StaticResource SecondaryText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="20"
                           Visibility="Collapsed"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Remove Selected" Click="RemoveSelected_Click" Height="28"
                            IsEnabled="{Binding ElementName=lstExclusions, Path=SelectedItems.Count}"/>
                    <Button Content="Clear All" Click="ClearAll_Click" Height="28"
                            Style="{StaticResource WarningButton}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Status Bar -->
        <Border Grid.Row="3" 
                Background="{StaticResource PanelBackground}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="10,8">
            <TextBlock x:Name="txtStatus" 
                       Text="Add files, folders, or extension patterns to exclude from backups."
                       Foreground="{StaticResource SecondaryText}"/>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="OK" Click="OK_Click" IsDefault="True" Width="100" Height="28" Style="{StaticResource SuccessButton}"/>
            <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" Width="100" Height="28"/>
        </StackPanel>
    </Grid>
</Window>
