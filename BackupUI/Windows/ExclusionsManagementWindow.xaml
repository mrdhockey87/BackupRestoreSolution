<Window
	x:Class="SecureServerBackup.ExclusionsManagementWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Manage Backup Exclusions"
	Width="700"
	Height="800"
	Background="{StaticResource WindowBackground}"
	WindowStartupLocation="CenterOwner">

	<Window.Resources>
		<Style TargetType="GroupBox">
			<Setter Property="Margin" Value="10" />
			<Setter Property="Padding" Value="10" />
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>

		<Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
			<Setter Property="MinWidth" Value="100" />
			<Setter Property="Margin" Value="5" />
			<Setter Property="Padding" Value="10,5" />
		</Style>
	</Window.Resources>

	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  System Exclusions (Read-Only)  -->
		<GroupBox Grid.Row="0" Header="System Exclusions (Non-Editable)">
			<StackPanel>
				<TextBlock
					Margin="0,0,0,10"
					Foreground="{StaticResource SecondaryText}"
					TextWrapping="Wrap">
					These items are automatically excluded to prevent backup failures and cannot be modified:
				</TextBlock>

				<TextBlock
					Margin="10,5"
					FontFamily="Consolas"
					FontSize="11">
					• System Volume Information (Access denied)
				</TextBlock>
				<TextBlock
					Margin="10,5"
					FontFamily="Consolas"
					FontSize="11">
					• $RECYCLE.BIN (Recycle bin)
				</TextBlock>
				<TextBlock
					Margin="10,5"
					FontFamily="Consolas"
					FontSize="11">
					• pagefile.sys (Windows page file - always locked)
				</TextBlock>
				<TextBlock
					Margin="10,5"
					FontFamily="Consolas"
					FontSize="11">
					• swapfile.sys (Windows swap file - always locked)
				</TextBlock>
				<TextBlock
					Margin="10,5"
					FontFamily="Consolas"
					FontSize="11">
					• hiberfil.sys (Hibernation file - always locked)
				</TextBlock>
			</StackPanel>
		</GroupBox>

		<!--  Add Exclusions Section  -->
		<GroupBox Grid.Row="1" Header="Add Custom Exclusions">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<!--  File/Folder Browsing  -->
				<StackPanel
					Grid.Row="0"
					Grid.Column="0"
					Orientation="Horizontal">
					<Button
						Width="130"
						Click="BrowseFile_Click"
						Content="Browse for File..." />
					<Button
						Width="130"
						Click="BrowseFolder_Click"
						Content="Browse for Folder..." />
				</StackPanel>

				<!--  Extension Entry  -->
				<StackPanel
					Grid.Row="1"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					Margin="0,10,0,0">
					<Label Content="Or enter file extension pattern (e.g., *.tmp, *.log):" />
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBox
							x:Name="txtExtensionPattern"
							Grid.Column="0"
							Padding="5"
							VerticalContentAlignment="Center"
							KeyDown="TxtExtensionPattern_KeyDown" />
						<Button
							Grid.Column="1"
							Margin="5,0,0,0"
							Click="AddPattern_Click"
							Content="Add Pattern" />
					</Grid>
				</StackPanel>
			</Grid>
		</GroupBox>

		<!--  Current User Exclusions List  -->
		<GroupBox Grid.Row="2" Header="Current Custom Exclusions">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<ListBox
					x:Name="lstExclusions"
					Grid.Row="0"
					HorizontalContentAlignment="Stretch"
					ScrollViewer.HorizontalScrollBarVisibility="Auto"
					SelectionMode="Extended">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<!--  Icon indicating type  -->
								<TextBlock
									Grid.Column="0"
									Margin="0,0,10,0"
									VerticalAlignment="Center"
									FontSize="16"
									Text="{Binding Icon}" />

								<!--  Path or pattern  -->
								<TextBlock
									Grid.Column="1"
									VerticalAlignment="Center"
									FontFamily="Consolas"
									FontSize="11"
									Text="{Binding Path}"
									TextWrapping="Wrap" />
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<TextBlock
					x:Name="txtNoExclusions"
					Grid.Row="0"
					Margin="20"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Foreground="{StaticResource SecondaryText}"
					Text="No custom exclusions defined. Add files, folders, or patterns above."
					TextWrapping="Wrap"
					Visibility="Collapsed" />

				<StackPanel
					Grid.Row="1"
					Margin="0,10,0,0"
					HorizontalAlignment="Right"
					Orientation="Horizontal">
					<Button
						Height="28"
						Click="RemoveSelected_Click"
						Content="Remove Selected"
						IsEnabled="{Binding ElementName=lstExclusions, Path=SelectedItems.Count}" />
					<Button
						Height="28"
						Click="ClearAll_Click"
						Content="Clear All"
						Style="{StaticResource WarningButton}" />
				</StackPanel>
			</Grid>
		</GroupBox>

		<!--  Status Bar  -->
		<Border
			Grid.Row="3"
			Padding="10,8"
			Background="{StaticResource PanelBackground}"
			BorderBrush="{StaticResource BorderBrush}"
			BorderThickness="0,1,0,0">
			<TextBlock
				x:Name="txtStatus"
				Foreground="{StaticResource SecondaryText}"
				Text="Add files, folders, or extension patterns to exclude from backups." />
		</Border>

		<!--  Action Buttons  -->
		<StackPanel
			Grid.Row="4"
			Margin="0,15,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				Width="100"
				Height="28"
				Click="OK_Click"
				Content="OK"
				IsDefault="True"
				Style="{StaticResource SuccessButton}" />
			<Button
				Width="100"
				Height="28"
				Click="Cancel_Click"
				Content="Cancel"
				IsCancel="True" />
		</StackPanel>
	</Grid>
</Window>
