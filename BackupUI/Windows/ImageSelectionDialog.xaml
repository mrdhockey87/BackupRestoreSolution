<Window
	x:Class="SecureServerBackup.Windows.ImageSelectionDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Select Restore Point"
	Width="600"
	Height="400"
	Background="{DynamicResource WindowBackground}"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<StackPanel Grid.Row="0" Margin="0,0,0,15">
			<TextBlock
				FontSize="16"
				FontWeight="Bold"
				Foreground="{DynamicResource PrimaryText}"
				Text="Multiple Restore Points Available" />
			<TextBlock
				x:Name="txtSubtitle"
				Margin="0,5,0,0"
				Foreground="{DynamicResource SecondaryText}"
				Text="This backup contains multiple restore points. Select which point to mount:"
				TextWrapping="Wrap" />
		</StackPanel>

		<!--  Image List  -->
		<Border
			Grid.Row="1"
			Background="White"
			BorderBrush="{DynamicResource LightBorderBrush}"
			BorderThickness="1">
			<DataGrid
				x:Name="dgImages"
				AlternatingRowBackground="{DynamicResource AlternateRowBackground}"
				AutoGenerateColumns="False"
				CanUserReorderColumns="False"
				CanUserResizeRows="False"
				GridLinesVisibility="Horizontal"
				HeadersVisibility="Column"
				IsReadOnly="True"
				MouseDoubleClick="dgImages_MouseDoubleClick"
				SelectionMode="Single">
				<DataGrid.Columns>
					<DataGridTextColumn
						Width="80"
						Binding="{Binding ImageIndex}"
						ElementStyle="{StaticResource CenterAlignedCell}"
						Header="Image #" />
					<DataGridTextColumn
						Width="180"
						Binding="{Binding ImageDate, StringFormat='MM/dd/yyyy HH:mm:ss'}"
						Header="Date/Time" />
					<DataGridTextColumn
						Width="120"
						Binding="{Binding ImageType}"
						Header="Type" />
					<DataGridTextColumn
						Width="*"
						Binding="{Binding Description}"
						Header="Description" />
				</DataGrid.Columns>
			</DataGrid>
		</Border>

		<!--  Buttons  -->
		<StackPanel
			Grid.Row="2"
			Margin="0,15,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				x:Name="btnAction"
				Width="130"
				Height="32"
				Margin="0,0,10,0"
				Click="btnMount_Click"
				Content="Mount Selected"
				Style="{StaticResource SuccessButton}" />
			<Button
				Width="100"
				Height="32"
				Click="btnCancel_Click"
				Content="Cancel"
				Style="{StaticResource SecondaryButton}" />
		</StackPanel>
	</Grid>
</Window>
