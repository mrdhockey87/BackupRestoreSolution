<Window
	x:Class="SecureServerBackup.CustomDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Message"
	MinWidth="150"
	MinHeight="50"
	MaxWidth="600"
	MaxHeight="500"
	AllowsTransparency="True"
	Background="Transparent"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeToContent="WidthAndHeight"
	WindowStartupLocation="CenterOwner"
	WindowStyle="None">

	<Window.Resources>
		<!--  Turquoise Theme Colors  -->
		<SolidColorBrush x:Key="WindowBackground" Color="#F5FFFF" />
		<SolidColorBrush x:Key="HeaderBackground" Color="#B0E0E6" />
		<SolidColorBrush x:Key="BorderBrush" Color="#20B2AA" />
		<SolidColorBrush x:Key="ButtonBackground" Color="#008B8B" />
		<SolidColorBrush x:Key="ButtonHover" Color="#20B2AA" />
		<SolidColorBrush x:Key="InfoBackground" Color="#E0F7F7" />
		<SolidColorBrush x:Key="WarningBackground" Color="#FFF8DC" />
		<SolidColorBrush x:Key="ErrorBackground" Color="#FFE4E1" />

		<!--  Button Style  -->
		<Style x:Key="DialogButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource ButtonBackground}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Padding" Value="20,8" />
			<Setter Property="Margin" Value="5" />
			<Setter Property="MinWidth" Value="100" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border
							Background="{TemplateBinding Background}"
							BorderBrush="{StaticResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="3">
							<ContentPresenter
								Margin="{TemplateBinding Padding}"
								HorizontalAlignment="Center"
								VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="{StaticResource ButtonHover}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Background" Value="#008080" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  Close Button Style  -->
		<Style x:Key="CloseButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="Black" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="Width" Value="30" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="3">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#FFAFEEEE" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Background" Value="#FF48D1CC" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border
		Background="{StaticResource WindowBackground}"
		BorderBrush="{StaticResource BorderBrush}"
		BorderThickness="2"
		CornerRadius="5">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="40" />
				<!--  Header  -->
				<RowDefinition Height="*" />
				<!--  Content  -->
				<RowDefinition Height="60" />
				<!--  Buttons  -->
			</Grid.RowDefinitions>

			<!--  Header  -->
			<Border
				Grid.Row="0"
				Background="{StaticResource HeaderBackground}"
				BorderBrush="{StaticResource BorderBrush}"
				BorderThickness="0,0,0,1"
				CornerRadius="3,3,0,0">
				<Grid>
					<TextBlock
						x:Name="txtTitle"
						Margin="15,0,0,0"
						VerticalAlignment="Center"
						FontSize="16"
						FontWeight="SemiBold"
						Foreground="Black"
						Text="Message" />
					<Button
						x:Name="btnClose"
						Margin="0,0,5,0"
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						Click="BtnClose_Click"
						Content="✕"
						Style="{StaticResource CloseButton}" />
				</Grid>
			</Border>

			<!--  Content  -->
			<Grid Grid.Row="1" Margin="0,0,20,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<!--  Icon  -->
					<ColumnDefinition Width="*" />
					<!--  Message  -->
				</Grid.ColumnDefinitions>

				<!--  Icon  -->
				<TextBlock
					x:Name="txtIcon"
					Grid.Column="0"
					Margin="0,10,20,10"
					VerticalAlignment="Top"
					FontSize="24" />

				<!--  Message  -->
				<TextBox
					x:Name="txtMessage"
					Grid.Column="1"
					MinWidth="250"
					VerticalAlignment="Center"
					Background="Transparent"
					BorderThickness="0"
					FontSize="14"
					Foreground="Black"
					HorizontalScrollBarVisibility="Disabled"
					IsReadOnly="True"
					IsTabStop="False"
					Text="Message text here"
					TextWrapping="Wrap"
					VerticalScrollBarVisibility="Auto" />
			</Grid>

			<!--  Buttons  -->
			<StackPanel
				Grid.Row="2"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Orientation="Horizontal">
				<Button
					x:Name="btnPrimary"
					Click="BtnPrimary_Click"
					Content="OK"
					IsDefault="True"
					Style="{StaticResource DialogButton}" />
				<Button
					x:Name="btnSecondary"
					Click="BtnSecondary_Click"
					Content="Cancel"
					IsCancel="True"
					Style="{StaticResource DialogButton}"
					Visibility="Collapsed" />
				<Button
					x:Name="btnTertiary"
					Click="BtnTertiary_Click"
					Content="No"
					Style="{StaticResource DialogButton}"
					Visibility="Collapsed" />
			</StackPanel>
		</Grid>
	</Border>
</Window>
