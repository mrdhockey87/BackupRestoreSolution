<Window x:Class="BackupUI.Windows.BackupProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Progress" Height="250" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtProgress" Grid.Row="0"
                   Text="Initializing backup..."
                   FontSize="14"
                   Margin="0,0,0,15"
                   TextWrapping="Wrap"/>

        <ProgressBar x:Name="progressBar" Grid.Row="1"
                     Height="25"
                     Minimum="0"
                     Maximum="100"
                     Value="0"/>

        <TextBlock x:Name="txtPercentage" Grid.Row="2"
                   Text="0%"
                   FontSize="12"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnAbort" Content="Abort Backup" Width="120" Height="30"
                    Margin="0,0,10,0"
                    Background="#FFDC8B8B"
                    Click="AbortBackup_Click"/>
            <Button Content="Hide Window" Width="120" Height="30"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
