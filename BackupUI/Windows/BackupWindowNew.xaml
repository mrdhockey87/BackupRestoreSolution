<Window
	x:Class="BackupUI.Windows.BackupWindowNew"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:BackupUI.Controls"
	xmlns:local="clr-namespace:BackupUI.Models"
	Title="Create Backup"
	Width="1000"
	Height="850"
	WindowStartupLocation="CenterOwner">
	<Window.Resources>
		<!--  TreeView Checkbox Style  -->
		<Style x:Key="TreeViewCheckBoxStyle" TargetType="CheckBox">
			<Setter Property="IsThreeState" Value="True" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,0,5,0" />
		</Style>
	</Window.Resources>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<TextBlock
			Grid.Row="0"
			Margin="0,0,0,15"
			FontSize="20"
			FontWeight="Bold"
			Text="Create Backup" />

		<!--  Main Content: Two Columns  -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!--  LEFT COLUMN: What to Backup  -->
			<GroupBox
				Grid.Column="0"
				Margin="0,0,10,0"
				Header="What to Backup">
				<Grid Margin="5">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock
						Grid.Row="0"
						Margin="0,0,0,10"
						FontSize="11"
						Foreground="{StaticResource SecondaryText}"
						TextWrapping="Wrap">
						Check drives or volumes to backup. Files and folders are shown when volumes are unchecked.
						Boot volumes will automatically include system state backup.
					</TextBlock>

					<Grid Grid.Row="1">
						<TreeView
							Name="treeViewDrives"
							BorderBrush="{StaticResource LightBorderBrush}"
							BorderThickness="1">
							<TreeView.ItemContainerStyle>
								<Style TargetType="TreeViewItem">
									<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
									<Setter Property="Padding" Value="2" />
								</Style>
							</TreeView.ItemContainerStyle>
						</TreeView>

						<!--  Loading Overlay  -->
						<Border
							Name="loadingOverlay"
							Background="{StaticResource PanelBackground}"
							Opacity="0.9"
							Visibility="Collapsed">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<TextBlock
									Margin="0,0,0,10"
									HorizontalAlignment="Center"
									FontSize="14"
									FontWeight="Bold"
									Text="Loading drives and volumes..." />
								<ProgressBar
									Width="200"
									Height="20"
									IsIndeterminate="True" />
							</StackPanel>
						</Border>
					</Grid>

					<StackPanel
						Grid.Row="2"
						Margin="0,10,0,0"
						Orientation="Horizontal">
						<Button
							Width="80"
							Margin="0,0,5,0"
							Click="RefreshDrives_Click"
							Content="Refresh" />
						<Button
							Width="80"
							Margin="0,0,5,0"
							Click="ExpandAll_Click"
							Content="Expand All" />
						<Button
							Width="80"
							Click="CollapseAll_Click"
							Content="Collapse All" />
					</StackPanel>
				</Grid>
			</GroupBox>

			<!--  RIGHT COLUMN: Settings and Schedule  -->
			<Grid Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!--  Settings Section  -->
				<GroupBox
					Grid.Row="0"
					Margin="0,0,0,10"
					Header="Settings">
					<StackPanel Margin="5">
						<TextBlock Margin="0,0,0,5" Text="Backup Name:" />
						<TextBox
							Name="txtBackupName"
							Height="25"
							Margin="0,0,0,15" />

						<TextBlock Margin="0,0,0,5" Text="Backup Type:" />
						<StackPanel Margin="0,0,0,15">
							<!--  First row  -->
							<StackPanel Margin="0,0,0,5" Orientation="Horizontal">
								<RadioButton
									Name="rbFullBackup"
									Margin="0,0,20,0"
									Checked="BackupType_Changed"
									Content="Full Backup"
									GroupName="BackupType"
									IsChecked="True" />
								<RadioButton
									Name="rbIncremental"
									Margin="0,0,20,0"
									Checked="BackupType_Changed"
									Content="Full then Incremental"
									GroupName="BackupType" />
								<RadioButton
									Name="rbDifferential"
									Checked="BackupType_Changed"
									Content="Full then Differential"
									GroupName="BackupType" />
							</StackPanel>
							<!--  Second row  -->
							<StackPanel Orientation="Horizontal">
								<RadioButton
									Name="rbCloneDisk"
									Margin="0,0,20,0"
									Checked="BackupType_Changed"
									Content="Clone to Disk"
									GroupName="BackupType" />
								<RadioButton
									Name="rbCloneVirtual"
									Margin="0,0,20,0"
									Checked="BackupType_Changed"
									Content="Clone to Virtual Disk (Hyper-V)"
									GroupName="BackupType" />
								<RadioButton
									Name="rbCloneHyperV"
									Checked="BackupType_Changed"
									Content="Clone Hyper-V System"
									GroupName="BackupType" />
							</StackPanel>
						</StackPanel>

						<StackPanel
							Name="pnlCloneOptions"
							Margin="0,0,0,15"
							Visibility="Collapsed">
							<TextBlock
								Name="txtCloneDestinationLabel"
								Margin="0,0,0,5"
								Text="Clone to Physical Disk:" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox
									Name="txtCloneDestination"
									Grid.Column="0"
									Height="25"
									Margin="0,0,5,0" />
								<Button
									Grid.Column="1"
									Width="80"
									Click="BrowseCloneDestination_Click"
									Content="Browse..." />
							</Grid>
						</StackPanel>

						<StackPanel Name="pnlBackupDestination" Visibility="Visible">
							<TextBlock Margin="0,0,0,5" Text="Backup Destination:" />
							<Grid Margin="0,0,0,15">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox
									Name="txtDestination"
									Grid.Column="0"
									Height="25"
									Margin="0,0,5,0" />
								<Button
									Grid.Column="1"
									Width="80"
									Click="BrowseDestination_Click"
									Content="Browse..." />
							</Grid>
						</StackPanel>

						<CheckBox
							Name="chkAutoSystemState"
							Margin="0,0,0,10"
							Content="Auto-include system state for boot volumes"
							IsChecked="True" />
						<CheckBox
							Name="chkCompress"
							Margin="0,0,0,10"
							Content="Compress backup data"
							IsChecked="True" />
						<CheckBox
							Name="chkSplitFiles"
							Margin="0,0,0,10"
							Content="Split into 4.7GB files (DVD size)"
							IsChecked="True" />
						<CheckBox
							Name="chkVerify"
							Margin="0,0,0,10"
							Content="Verify backup after completion"
							IsChecked="True" />

						<Button
							Name="btnManageExclusions"
							Width="150"
							Margin="0,0,0,15"
							HorizontalAlignment="Left"
							Click="ManageExclusions_Click"
							Content="Manage Exclusions..."
							ToolTip="Configure files, folders, and patterns to exclude from backup" />

						<StackPanel Name="pnlRetentionSettings" Visibility="Collapsed">
							<TextBlock
								Margin="0,0,0,5"
								FontWeight="SemiBold"
								Text="Full Backup Retention:" />
							<TextBlock
								Margin="0,0,0,5"
								FontSize="10"
								Foreground="{StaticResource SecondaryText}"
								Text="Specify how many full backups to keep (applies to Full backup type only)"
								TextWrapping="Wrap" />
							<Grid Margin="0,0,0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Margin="0,0,5,0"
									VerticalAlignment="Center"
									Text="Keep last" />
								<TextBox
									Name="txtRetainCount"
									Grid.Column="1"
									Height="25"
									HorizontalContentAlignment="Center"
									VerticalContentAlignment="Center"
									Text="1" />
								<TextBlock
									Grid.Column="2"
									Margin="5,0,0,0"
									VerticalAlignment="Center"
									Text="full backup(s)" />
							</Grid>
							<TextBlock
								Margin="0,0,0,0"
								FontSize="10"
								Foreground="{StaticResource SecondaryText}"
								TextWrapping="Wrap">
								Note: When keeping more than 1 backup, date/time will be added to backup names. Old backups are only deleted after successful verification.
							</TextBlock>
						</StackPanel>
					</StackPanel>
				</GroupBox>

				<!--  Schedule Section  -->
				<GroupBox Grid.Row="1" Header="Schedule">
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<StackPanel Margin="5">
							<CheckBox
								Name="chkEnableSchedule"
								Margin="0,0,0,15"
								Checked="Schedule_CheckedChanged"
								Content="Enable Scheduled Backup"
								Unchecked="Schedule_CheckedChanged" />

							<StackPanel Name="pnlSchedule" IsEnabled="False">
								<TextBlock Margin="0,0,0,5" Text="Frequency:" />
								<ComboBox
									Name="cmbFrequency"
									Height="25"
									Margin="0,0,0,15"
									SelectionChanged="Frequency_SelectionChanged">
									<ComboBoxItem Content="Daily" IsSelected="True" />
									<ComboBoxItem Content="Weekly" />
									<ComboBoxItem Content="Monthly" />
									<ComboBoxItem Content="Once" />
								</ComboBox>

								<TextBlock Margin="0,0,0,5" Text="Time:" />
								<StackPanel Margin="0,0,0,15" Orientation="Horizontal">
									<ComboBox
										Name="cmbHour"
										Width="60"
										Margin="0,0,5,0" />
									<TextBlock
										Margin="0,0,5,0"
										VerticalAlignment="Center"
										Text=":" />
									<ComboBox
										Name="cmbMinute"
										Width="60"
										Margin="0,0,10,0"
										IsEditable="True"
										IsTextSearchEnabled="False" />
									<ComboBox Name="cmbAmPm" Width="60">
										<ComboBoxItem Content="AM" />
										<ComboBoxItem Content="PM" />
									</ComboBox>
								</StackPanel>

								<StackPanel
									Name="pnlWeekly"
									Margin="0,0,0,15"
									Visibility="Collapsed">
									<TextBlock Margin="0,0,0,5" Text="Days of Week:" />
									<StackPanel>
										<CheckBox Name="chkMonday" Content="Monday" />
										<CheckBox Name="chkTuesday" Content="Tuesday" />
										<CheckBox Name="chkWednesday" Content="Wednesday" />
										<CheckBox Name="chkThursday" Content="Thursday" />
										<CheckBox Name="chkFriday" Content="Friday" />
										<CheckBox Name="chkSaturday" Content="Saturday" />
										<CheckBox Name="chkSunday" Content="Sunday" />
									</StackPanel>
								</StackPanel>

								<StackPanel
									Name="pnlMonthly"
									Margin="0,0,0,15"
									Visibility="Collapsed">
									<TextBlock Margin="0,0,0,5" Text="Day of Month:" />
									<ComboBox
										Name="cmbDayOfMonth"
										Width="60"
										HorizontalAlignment="Left" />
								</StackPanel>
							</StackPanel>
						</StackPanel>
					</ScrollViewer>
				</GroupBox>
			</Grid>
		</Grid>

		<!--  Progress Bar  -->
		<ProgressBar
			Name="progressBar"
			Grid.Row="2"
			Height="20"
			Margin="0,10,0,10"
			Visibility="Collapsed" />
		<TextBlock
			Name="txtProgress"
			Grid.Row="2"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Visibility="Collapsed" />

		<!--  Action Buttons  -->
		<StackPanel
			Grid.Row="3"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				Width="100"
				Margin="0,0,5,0"
				Click="StartBackup_Click"
				Content="Start Backup" />
			<Button
				Width="100"
				Margin="0,0,5,0"
				Click="SaveJob_Click"
				Content="Save Job" />
			<Button
				Width="100"
				Click="Cancel_Click"
				Content="Cancel" />
		</StackPanel>
	</Grid>
</Window>
