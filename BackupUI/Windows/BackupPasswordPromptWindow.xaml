<Window
	x:Class="SecureServerBackup.Windows.BackupPasswordPromptWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Backup Password"
	Width="420"
	Height="210"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock
			Grid.Row="0"
			Margin="0,0,0,12"
			FontWeight="SemiBold"
			Text="Enter the password for this encrypted backup."
			TextWrapping="Wrap" />

		<TextBlock
			Grid.Row="1"
			Margin="0,0,0,5"
			Text="Password:" />

		<Grid Grid.Row="2" Margin="0,0,0,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<PasswordBox
				x:Name="pwdPassword"
				Grid.Column="0"
				Height="28"
				PasswordChanged="PasswordBox_PasswordChanged" />
			<TextBox
				x:Name="txtPasswordVisible"
				Grid.Column="0"
				Height="28"
				TextChanged="VisiblePassword_TextChanged"
				Visibility="Collapsed" />
			<CheckBox
				x:Name="chkShowPassword"
				Grid.Column="1"
				Margin="10,0,0,0"
				VerticalAlignment="Center"
				Checked="ShowPassword_CheckedChanged"
				Content="Show"
				Unchecked="ShowPassword_CheckedChanged" />
		</Grid>

		<TextBlock
			x:Name="txtError"
			Grid.Row="3"
			Foreground="DarkRed"
			TextWrapping="Wrap"
			Visibility="Collapsed" />

		<StackPanel
			Grid.Row="4"
			Margin="0,15,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				Width="90"
				Margin="0,0,10,0"
				Click="Ok_Click"
				Content="OK" />
			<Button
				Width="90"
				Click="Cancel_Click"
				Content="Cancel" />
		</StackPanel>
	</Grid>
</Window>
