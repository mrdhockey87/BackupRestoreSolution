<Window
	x:Class="SecureServerBackup.Windows.RestoreWindowNew"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Restore Backup"
	Width="900"
	Height="690"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock
			Grid.Row="0"
			Margin="0,0,0,15"
			FontSize="20"
			FontWeight="Bold"
			Text="Restore from Backup" />

		<!--  Backup Source Selection  -->
		<GroupBox
			Grid.Row="1"
			Margin="0,0,0,10"
			Padding="10"
			Header="Select Backup">
			<StackPanel>
				<TextBlock Margin="0,0,0,5" Text="Backup Source:" />
				<Grid Margin="0,0,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBox
						Name="txtBackupSource"
						Grid.Column="0"
						Height="25"
						Margin="0,0,5,0"
						IsReadOnly="True" />
					<Button
						Grid.Column="1"
						Width="80"
						Click="BrowseBackup_Click"
						Content="Browse..." />
				</Grid>

				<Button
					Width="120"
					Margin="0,5,0,0"
					HorizontalAlignment="Left"
					Click="ScanBackup_Click"
					Content="Scan Backup" />

				<!--  Backup Set Info  -->
				<StackPanel
					Name="pnlBackupInfo"
					Margin="0,10,0,0"
					Visibility="Collapsed">
					<TextBlock
						Name="txtBackupInfo"
						Margin="0,0,0,5"
						Foreground="{StaticResource SecondaryText}"
						TextWrapping="Wrap" />

					<TextBlock
						Margin="0,10,0,5"
						FontWeight="Bold"
						Text="Select Restore Point:" />
					<ListBox
						Name="lstRestorePoints"
						Height="100"
						SelectionChanged="RestorePoints_SelectionChanged">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel>
									<TextBlock FontWeight="Bold" Text="{Binding DisplayName}" />
									<TextBlock
										FontSize="10"
										Foreground="{StaticResource SecondaryText}"
										Text="{Binding Description}" />
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</StackPanel>
			</StackPanel>
		</GroupBox>

		<!--  Restore Options  -->
		<GroupBox
			Name="grpRestoreOptions"
			Grid.Row="2"
			Padding="10"
			Header="Restore Options"
			IsEnabled="False">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<TextBlock
						Margin="0,0,0,5"
						FontWeight="Bold"
						Text="What to Restore:" />
					<RadioButton
						Name="rbRestoreAll"
						Margin="0,0,0,5"
						Content="Restore everything from backup"
						IsChecked="True" />
					<RadioButton
						Name="rbRestoreSelected"
						Margin="0,0,0,15"
						Content="Select specific items to restore" />

					<StackPanel
						Name="pnlItemSelection"
						Margin="0,0,0,15"
						Visibility="Collapsed">
						<ListBox
							Name="lstBackupItems"
							Height="150"
							SelectionChanged="RestoreItems_SelectionChanged"
							SelectionMode="Multiple" />
					</StackPanel>

					<TextBlock
						Margin="0,0,0,5"
						FontWeight="Bold"
						Text="Restore Destination:" />
					<TextBlock
						Name="txtDestinationHelp"
						Margin="0,0,0,8"
						Foreground="{StaticResource SecondaryText}"
						Text="Select where the restore should be written."
						TextWrapping="Wrap" />

					<!--  Hyper-V backup point restore mode selector  -->
					<StackPanel
						Name="pnlHyperVRestoreMode"
						Margin="0,0,0,10"
						Visibility="Collapsed">
						<TextBlock
							Margin="0,0,0,5"
							FontWeight="Bold"
							Text="Hyper-V Restore Target:" />
						<ComboBox
							Name="cmbHyperVRestoreTarget"
							MinWidth="260"
							SelectedIndex="0"
							SelectionChanged="HyperVRestoreTarget_Changed">
							<ComboBoxItem Content="Restore exported files/folders" Tag="Files" />
							<ComboBoxItem Content="Restore guest disk to volume" Tag="Volume" />
							<ComboBoxItem Content="Restore guest disk to disk" Tag="Disk" />
							<ComboBoxItem Content="Restore as Hyper-V virtual machine" Tag="HyperVVm" />
						</ComboBox>
					</StackPanel>

					<!--  Hyper-V VM restore sub-options (replace existing VM or restore to directory)  -->
					<StackPanel
						Name="pnlHyperVVmOptions"
						Margin="0,0,0,10"
						Visibility="Collapsed">
						<TextBlock
							Margin="0,0,0,5"
							FontWeight="Bold"
							Text="Restore Mode:" />
						<RadioButton
							Name="rbHyperVReplaceExisting"
							Margin="0,0,0,5"
							Checked="HyperVVmRestoreMode_Changed"
							Content="Replace a non-running Hyper-V virtual machine"
							IsChecked="True" />
						<RadioButton
							Name="rbHyperVRestoreToDirectory"
							Margin="0,0,0,8"
							Checked="HyperVVmRestoreMode_Changed"
							Content="Restore to an empty directory" />

						<!--  Replace existing VM picker  -->
						<StackPanel Name="pnlHyperVReplaceExistingOptions" Margin="20,0,0,8">
							<TextBlock Margin="0,0,0,5" Text="Select a non-running virtual machine to replace:" />
							<ComboBox
								Name="cmbHyperVVmToReplace"
								MinWidth="260"
								Margin="0,0,0,5" />
						</StackPanel>

						<!--  Restore to directory picker  -->
						<StackPanel
							Name="pnlHyperVDirectoryOptions"
							Margin="20,0,0,8"
							Visibility="Collapsed">
							<TextBlock Margin="0,0,0,5" Text="Restore destination directory (must be empty):" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox
									Name="txtHyperVRestoreDirectory"
									Grid.Column="0"
									Height="25"
									Margin="0,0,5,0" />
								<Button
									Grid.Column="1"
									Width="80"
									Click="BrowseHyperVRestoreDirectory_Click"
									Content="Browse..." />
							</Grid>
						</StackPanel>

						<TextBlock Margin="0,4,0,5" Text="Virtual machine name after restore:" />
						<TextBox
							Name="txtHyperVVmName"
							Height="25"
							Margin="0,0,0,8" />
						<CheckBox
							Name="chkStartHyperVVm"
							Content="Start the virtual machine after restore"
							IsChecked="False" />
					</StackPanel>

					<!--  Drive / Volume target tree (for disk and volume backups)  -->
					<StackPanel
						Name="pnlDriveTargetTree"
						Margin="0,0,0,10"
						Visibility="Collapsed">
						<TextBlock
							Margin="0,0,0,5"
							FontWeight="Bold"
							Text="Select Restore Target:" />
						<TextBlock
							Name="txtDriveTreeHelp"
							Margin="0,0,0,6"
							Foreground="{StaticResource SecondaryText}"
							Text="Choose the target disk or volume. Boot and system disks are shown but cannot be selected."
							TextWrapping="Wrap" />
						<Grid>
							<TreeView
								Name="treeViewRestoreTarget"
								Height="160"
								BorderBrush="{StaticResource LightBorderBrush}"
								BorderThickness="1" />
							<Border
								Name="loadingTargetOverlay"
								Background="{StaticResource PanelBackground}"
								Opacity="0.9"
								Visibility="Collapsed">
								<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
									<TextBlock
										Margin="0,0,0,6"
										HorizontalAlignment="Center"
										FontSize="12"
										Text="Loading drives..." />
									<ProgressBar
										Width="160"
										Height="16"
										IsIndeterminate="True" />
								</StackPanel>
							</Border>
						</Grid>
						<StackPanel Margin="0,5,0,0" Orientation="Horizontal">
							<Button
								Width="80"
								Margin="0,0,5,0"
								Click="RefreshRestoreTarget_Click"
								Content="Refresh" />
							<TextBlock
								Name="txtSelectedTargetLabel"
								Margin="10,0,0,0"
								VerticalAlignment="Center"
								FontStyle="Italic"
								Foreground="{StaticResource SecondaryText}"
								Text="No target selected" />
						</StackPanel>
					</StackPanel>

					<!--  Regular Hyper-V virtual disk restore (restore physical/volume backup into .vhdx)  -->
					<CheckBox
						Name="chkRestoreToHyperVDisk"
						Margin="0,0,0,8"
						Checked="RegularHyperVRestoreOption_Changed"
						Content="Restore into a Hyper-V virtual disk (.vhdx)"
						Unchecked="RegularHyperVRestoreOption_Changed"
						Visibility="Collapsed" />
					<StackPanel
						Name="pnlRegularHyperVRestore"
						Margin="0,0,0,10"
						Visibility="Collapsed">
						<TextBlock Margin="0,0,0,5" Text="Hyper-V virtual disk file:" />
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBox
								Name="txtHyperVVirtualDiskPath"
								Grid.Column="0"
								Height="25"
								Margin="0,0,5,0" />
							<Button
								Grid.Column="1"
								Width="80"
								Click="BrowseHyperVVirtualDisk_Click"
								Content="Browse..." />
						</Grid>
						<TextBlock
							Margin="0,0,0,5"
							FontWeight="Bold"
							Text="After restore:" />
						<RadioButton
							Name="rbLeaveHyperVDiskDetached"
							Margin="0,0,0,5"
							Checked="ExistingHyperVVmAttach_Changed"
							Content="Leave the restored virtual disk detached"
							IsChecked="True" />
						<RadioButton
							Name="chkAttachToExistingHyperVVm"
							Margin="0,0,0,8"
							Checked="ExistingHyperVVmAttach_Changed"
							Content="Attach the restored virtual disk to an existing Hyper-V virtual machine after restore"
							Unchecked="ExistingHyperVVmAttach_Changed" />
						<RadioButton
							Name="rbCreateNewHyperVVm"
							Margin="0,0,0,8"
							Checked="ExistingHyperVVmAttach_Changed"
							Content="Create a new Hyper-V virtual machine using the restored virtual disk"
							Unchecked="ExistingHyperVVmAttach_Changed" />
						<StackPanel Name="pnlExistingHyperVVmOptions" Visibility="Collapsed">
							<TextBlock Margin="0,0,0,5" Text="Existing Hyper-V virtual machine:" />
							<ComboBox Name="cmbExistingHyperVVm" MinWidth="260" />
						</StackPanel>
						<StackPanel Name="pnlNewHyperVVmOptions" Visibility="Collapsed">
							<TextBlock Margin="0,0,0,5" Text="New Hyper-V virtual machine name:" />
							<TextBox
								Name="txtNewHyperVVmName"
								Height="25"
								Margin="0,0,0,8" />
							<TextBlock Margin="0,0,0,5" Text="Virtual machine storage folder:" />
							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox
									Name="txtNewHyperVVmPath"
									Grid.Column="0"
									Height="25"
									Margin="0,0,5,0" />
								<Button
									Grid.Column="1"
									Width="80"
									Click="BrowseNewHyperVVmLocation_Click"
									Content="Browse..." />
							</Grid>
							<TextBlock Margin="0,0,0,5" Text="Virtual machine generation:" />
							<ComboBox
								Name="cmbNewHyperVGeneration"
								MinWidth="160"
								Margin="0,0,0,8"
								SelectedIndex="1">
								<ComboBoxItem Content="Generation 1" Tag="1" />
								<ComboBoxItem Content="Generation 2" Tag="2" />
							</ComboBox>
							<CheckBox
								Name="chkStartCreatedHyperVVm"
								Content="Start the new virtual machine after restore"
								IsChecked="True" />
						</StackPanel>
					</StackPanel>

					<!--  File / folder restore location choice  -->
					<StackPanel Name="pnlLocationChoice" Margin="0,0,0,0">
						<RadioButton
							Name="rbOriginalLocation"
							Margin="0,0,0,5"
							Checked="RestoreLocation_Changed"
							Content="Original location"
							IsChecked="True" />
						<RadioButton
							Name="rbAlternateLocation"
							Margin="0,0,0,5"
							Checked="RestoreLocation_Changed"
							Content="Alternate location" />
						<Grid
							Name="pnlAlternateLocation"
							Margin="0,5,0,15"
							Visibility="Collapsed">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBox
								Name="txtFolderRestoreDestination"
								Grid.Column="0"
								Height="25"
								Margin="0,0,5,0" />
							<Button
								Grid.Column="1"
								Width="80"
								Click="BrowseRestoreDestination_Click"
								Content="Browse..." />
						</Grid>
					</StackPanel>

					<CheckBox
						Name="chkOverwrite"
						Margin="0,10,0,10"
						Content="Overwrite existing files"
						IsChecked="False" />
					<CheckBox
						Name="chkPreservePermissions"
						Margin="0,0,0,10"
						Content="Preserve file permissions and attributes"
						IsChecked="True" />
					<CheckBox
						Name="chkVerifyAfterRestore"
						Content="Verify files after restore"
						IsChecked="True" />
				</StackPanel>
			</ScrollViewer>
		</GroupBox>

		<!--  Progress  -->
		<StackPanel
			Name="pnlProgress"
			Grid.Row="3"
			Margin="0,10,0,10"
			Visibility="Collapsed">
			<ProgressBar
				Name="progressBar"
				Height="20"
				Margin="0,0,0,5" />
			<TextBlock
				Name="txtProgress"
				HorizontalAlignment="Center"
				FontSize="11" />
			<TextBlock
				Name="txtCurrentRestoreItem"
				Margin="0,8,0,0"
				HorizontalAlignment="Left"
				FontSize="11"
				Foreground="{StaticResource SecondaryText}"
				TextWrapping="Wrap" />
		</StackPanel>

		<!--  Buttons  -->
		<StackPanel
			Grid.Row="4"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
			<Button
				Name="btnRestore"
				Width="100"
				Margin="0,0,5,0"
				Click="StartRestore_Click"
				Content="Start Restore"
				IsEnabled="False" />
			<Button
				Width="100"
				Click="Cancel_Click"
				Content="Cancel" />
		</StackPanel>
	</Grid>
</Window>
