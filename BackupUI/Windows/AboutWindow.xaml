<Window
	x:Class="SecureServerBackup.Windows.AboutWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="About Backup &amp; Restore Solution"
	Width="550"
	Height="450"
	Background="#F5F5F5"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner">
	<Window.Resources>
		<!--  Custom GroupBox style with VeryLightTurquoise background, LightTurquoise header/border  -->
		<Style x:Key="AboutGroupBoxStyle" TargetType="GroupBox">
			<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
			<Setter Property="BorderBrush" Value="{StaticResource LightTurquoise}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="HeaderTemplate">
				<Setter.Value>
					<DataTemplate>
						<Border Padding="5,0" Background="{StaticResource LightTurquoise}">
							<TextBlock
								FontSize="13"
								FontWeight="SemiBold"
								Text="{Binding}" />
						</Border>
					</DataTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<Border
			Grid.Row="0"
			Padding="20"
			Background="{StaticResource HelpHeaderBackground}">
			<StackPanel>
				<TextBlock
					HorizontalAlignment="Center"
					FontSize="24"
					FontWeight="Bold"
					Foreground="White"
					Text="Backup &amp; Restore Solution" />
				<TextBlock
					Name="txtMainVersion"
					Margin="0,5,0,0"
					HorizontalAlignment="Center"
					FontSize="14"
					Foreground="#ECF0F1"
					Text="Version 5.13.3.0" />
			</StackPanel>
		</Border>

		<!--  Content  -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="30,20">
				<!--  Component Versions  -->
				<GroupBox
					Margin="0,0,0,20"
					Padding="15"
					Header="Component Versions"
					Style="{StaticResource AboutGroupBoxStyle}">
					<StackPanel>
						<StackPanel Margin="0,5" Orientation="Horizontal">
							<TextBlock
								Width="200"
								FontWeight="SemiBold"
								Text="User Interface (BackupUI):" />
							<TextBlock
								Name="txtUIVersion"
								FontFamily="Consolas"
								Text="5.13.3.0" />
						</StackPanel>
						<StackPanel Margin="0,5" Orientation="Horizontal">
							<TextBlock
								Width="200"
								FontWeight="SemiBold"
								Text="Backup Service:" />
							<TextBlock
								Name="txtServiceVersion"
								FontFamily="Consolas"
								Text="Checking..." />
							<TextBlock
								Name="txtServiceWarning"
								Margin="10,0,0,0"
								FontWeight="Bold"
								Foreground="{StaticResource WarningText}"
								Text=" ⚠️ Not Running"
								Visibility="Collapsed" />
						</StackPanel>
						<StackPanel Margin="0,5" Orientation="Horizontal">
							<TextBlock
								Width="200"
								FontWeight="SemiBold"
								Text="Backup Engine (C++):" />
							<TextBlock
								Name="txtEngineVersion"
								FontFamily="Consolas"
								Text="5.13.3.0" />
						</StackPanel>
					</StackPanel>
				</GroupBox>

				<!--  Description  -->
				<GroupBox
					Margin="0,0,0,20"
					Padding="15"
					Header="Description"
					Style="{StaticResource AboutGroupBoxStyle}">
					<TextBlock TextWrapping="Wrap">
						Enterprise-grade backup solution for Windows Servers with support for:<LineBreak /><LineBreak />
						• Full, Incremental, and Differential backups<LineBreak />
						• Hyper-V Virtual Machine backups<LineBreak />
						• Volume Shadow Copy (VSS) integration<LineBreak />
						• System State backup and restore<LineBreak />
						• Disk and Volume cloning<LineBreak />
						• Network path support (UNC shares)<LineBreak />
						• Scheduled automated backups<LineBreak />
						• Windows Service-based execution<LineBreak />
						• Mount backups as read-only drives<LineBreak />
						• Cross-platform restore (Linux ISO included)</TextBlock>
				</GroupBox>

				<!--  Copyright  -->
				<GroupBox
					Padding="15"
					Header="Copyright"
					Style="{StaticResource AboutGroupBoxStyle}">
					<StackPanel>
						<TextBlock TextWrapping="Wrap">
							© 2026 Backup &amp; Restore Solution<LineBreak /><LineBreak />
							Developed By Mark Dail with GitHub Copilot assistance</TextBlock>
					</StackPanel>
				</GroupBox>
			</StackPanel>
		</ScrollViewer>

		<!--  Footer  -->
		<Border
			Grid.Row="2"
			Padding="15"
			Background="{StaticResource HelpHeaderBackground}"
			BorderBrush="{StaticResource LightBorderBrush}"
			BorderThickness="0,1,0,0">
			<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
				<Button
					Width="100"
					Height="30"
					Click="OK_Click"
					Content="OK"
					IsDefault="True" />
			</StackPanel>
		</Border>
	</Grid>
</Window>
