<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net8.0-windows</TargetFramework>
  <Nullable>enable</Nullable>
  <UseWPF>true</UseWPF>
  <UseWindowsForms>true</UseWindowsForms>
  <Platforms>x64</Platforms>
  <ApplicationManifest>app.manifest</ApplicationManifest>
  <ApplicationIcon>SSB_LogoWinIcos.ico</ApplicationIcon>
  <!-- Version, OutputPath, and Runtime config generation come from Directory.Build.props -->
</PropertyGroup>
<ItemGroup>
  <None Remove="Images\error_icon.svg" />
  <None Remove="Images\warning_icon.svg" />
</ItemGroup>
<ItemGroup>
  <Content Include="SSB_LogoWinIcos.ico" />
</ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.3" />
    <PackageReference Include="System.Management" Version="10.0.3" />
    <PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
    <PackageReference Include="zlib-msvc-x64" Version="1.2.11.8900" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Images\error_icon.svg" />
    <Resource Include="Images\warning_icon.svg" />
  </ItemGroup>
  
  <!-- Copy BackupEngine.dll to centralized output directory after C++ build -->
  <Target Name="CopyBackupEngine" AfterTargets="Build">
    <ItemGroup>
      <BackupEngineDll Include="$(SolutionDir)artifacts\bin\$(Configuration)\BackupEngine.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BackupEngineDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(SolutionDir)artifacts\bin\$(Configuration)\BackupEngine.dll')" />
    <Message Text="Copied BackupEngine.dll to centralized output: $(OutDir)" Importance="high" Condition="Exists('$(SolutionDir)artifacts\bin\$(Configuration)\BackupEngine.dll')" />
    <Warning Text="BackupEngine.dll not found - Build BackupEngine C++ project first!" Condition="!Exists('$(SolutionDir)artifacts\bin\$(Configuration)\BackupEngine.dll')" />
  </Target>
</Project>
