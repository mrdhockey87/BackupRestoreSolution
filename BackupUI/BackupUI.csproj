<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net8.0-windows</TargetFramework>
  <Nullable>enable</Nullable>
  <UseWPF>true</UseWPF>
  <UseWindowsForms>true</UseWindowsForms>
  <Platforms>x64</Platforms>
  <ApplicationManifest>app.manifest</ApplicationManifest>
  <!-- Version comes from Directory.Build.props -->
  <!-- Ensure runtime config is generated -->
  <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  <!-- Explicitly enable deps.json generation -->
  <GenerateDependencyFile>true</GenerateDependencyFile>
</PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.2" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
    <PackageReference Include="zlib-msvc-x64" Version="1.2.11.8900" />
  </ItemGroup>
  
  <!-- Copy BackupEngine.dll to centralized output directory after C++ build -->
  <Target Name="CopyBackupEngine" AfterTargets="Build">
    <ItemGroup>
      <BackupEngineDll Include="$(SolutionDir)artifacts\bin\$(Configuration)\BackupEngine.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BackupEngineDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(SolutionDir)artifacts\bin\$(Configuration)\BackupEngine.dll')" />
    <Message Text="Copied BackupEngine.dll to centralized output: $(OutDir)" Importance="high" Condition="Exists('$(SolutionDir)artifacts\bin\$(Configuration)\BackupEngine.dll')" />
    <Warning Text="BackupEngine.dll not found - Build BackupEngine C++ project first!" Condition="!Exists('$(SolutionDir)artifacts\bin\$(Configuration)\BackupEngine.dll')" />
  </Target>
  
  <!-- Ensure runtime config files are in the output directory -->
  <Target Name="EnsureRuntimeConfig" AfterTargets="Build">
    <ItemGroup>
      <RuntimeConfigSource Include="$(IntermediateOutputPath)$(TargetFramework)\$(AssemblyName).runtimeconfig.json" />
      <DepsFileSource Include="$(IntermediateOutputPath)$(TargetFramework)\$(AssemblyName).deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeConfigSource)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" Condition="Exists('@(RuntimeConfigSource)')" />
    <Copy SourceFiles="@(DepsFileSource)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" Condition="Exists('@(DepsFileSource)')" />
    <Message Text="Copied runtime config files to $(OutDir)" Importance="high" Condition="Exists('@(RuntimeConfigSource)')" />
  </Target>
</Project>
