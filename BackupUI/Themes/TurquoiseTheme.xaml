<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		================================================================
		TURQUOISE THEME COLOR PALETTE
		================================================================
		All colors explicitly defined to prevent Windows dark mode overrides.
		Color scheme: Turquoise (blue-green) with black text.
		================================================================
	-->

	<!--  Primary Turquoise Colors  -->
	<SolidColorBrush x:Key="PrimaryTurquoise" Color="#20B2AA" />
	<!--  Light Sea Green  -->
	<SolidColorBrush x:Key="DarkTurquoise" Color="#00CED1" />
	<!--  Dark Turquoise  -->
	<SolidColorBrush x:Key="MediumTurquoise" Color="#48D1CC" />
	<!--  Medium Turquoise  -->
	<SolidColorBrush x:Key="LightTurquoise" Color="#AFEEEE" />
	<!--  Pale Turquoise  -->
	<SolidColorBrush x:Key="VeryLightTurquoise" Color="#E0F7F7" />
	<!--  Very Light Turquoise  -->

	<!--  Button Colors  -->
	<SolidColorBrush x:Key="ButtonBackground" Color="#008B8B" />
	<!--  Dark Cyan (Dark Turquoise for buttons)  -->
	<SolidColorBrush x:Key="ButtonForeground" Color="#000000" />
	<!--  Black  -->
	<SolidColorBrush x:Key="ButtonHover" Color="#20B2AA" />
	<!--  Light Sea Green  -->
	<SolidColorBrush x:Key="ButtonPressed" Color="#5F9EA0" />
	<!--  Cadet Blue  -->

	<!--  Text Colors  -->
	<SolidColorBrush x:Key="PrimaryText" Color="#000000" />
	<!--  Black  -->
	<SolidColorBrush x:Key="SecondaryText" Color="#333333" />
	<!--  Dark Gray  -->
	<SolidColorBrush x:Key="ErrorText" Color="#8B0000" />
	<!--  Dark Red  -->
	<SolidColorBrush x:Key="WarningText" Color="#FF8C00" />
	<!--  Dark Orange  -->
	<SolidColorBrush x:Key="SuccessText" Color="#006400" />
	<!--  Dark Green  -->
	<SolidColorBrush x:Key="InfoText" Color="#000080" />
	<!--  Navy Blue  -->

	<!--  Background Colors  -->
	<SolidColorBrush x:Key="WindowBackground" Color="#F5FFFF" />
	<!--  Very light turquoise tint  -->
	<SolidColorBrush x:Key="PanelBackground" Color="#E0F7F7" />
	<!--  Light turquoise  -->
	<SolidColorBrush x:Key="AlternateRowBackground" Color="#5F9EA0" />
	<!--  Cadet Blue  -->
	<SolidColorBrush x:Key="HeaderBackground" Color="#B0E0E6" />
	<!--  Powder Blue  -->
	<SolidColorBrush x:Key="StatusBarBackground" Color="#AFEEEE" />
	<!--  Pale Turquoise  -->

	<!--  Border Colors  -->
	<SolidColorBrush x:Key="BorderBrush" Color="#5F9EA0" />
	<!--  Cadet Blue  -->
	<SolidColorBrush x:Key="LightBorderBrush" Color="#B0E0E6" />
	<!--  Powder Blue  -->

	<!--  Selection Colors  -->
	<SolidColorBrush x:Key="SelectionBackground" Color="#008B8B" />
	<!--  Dark Cyan  -->
	<SolidColorBrush x:Key="SelectionForeground" Color="#FFFFFF" />
	<!--  White for contrast on dark turquoise  -->

	<!--  Status-specific Colors  -->
	<SolidColorBrush x:Key="SuccessBackground" Color="#E6F4EA" />
	<!--  Very light green tint  -->
	<SolidColorBrush x:Key="WarningBackground" Color="#FFF8DC" />
	<!--  Cornsilk  -->
	<SolidColorBrush x:Key="ErrorBackground" Color="#FFE4E1" />
	<!--  Misty Rose  -->
	<SolidColorBrush x:Key="InfoBackground" Color="#E0F7F7" />
	<!--  Light Turquoise  -->
	<SolidColorBrush x:Key="HelpHeaderBackground" Color="#2C3E50" />
	<!--  Dark Blue-Gray  -->
	<!--
		================================================================
		BUTTON STYLES
		================================================================
	-->
	<Style x:Key="TurquoiseButton" TargetType="Button">
		<Setter Property="Background" Value="{StaticResource ButtonBackground}" />
		<Setter Property="Foreground" Value="{StaticResource ButtonForeground}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="10,5" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="3">
						<ContentPresenter
							Margin="{TemplateBinding Padding}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="{StaticResource ButtonHover}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="Background" Value="{StaticResource ButtonPressed}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.5" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  Default Button Style  -->
	<Style BasedOn="{StaticResource TurquoiseButton}" TargetType="Button" />

	<!--
		================================================================
		WINDOW STYLE
		================================================================
	-->
	<Style TargetType="Window">
		<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
	</Style>

	<!--
		================================================================
		TEXTBLOCK STYLE
		================================================================
	-->
	<Style TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
	</Style>

	<!--
		================================================================
		DATAGRID STYLE
		================================================================
	-->
	<Style TargetType="DataGrid">
		<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="RowBackground" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="AlternatingRowBackground" Value="{StaticResource AlternateRowBackground}" />
		<Setter Property="GridLinesVisibility" Value="All" />
		<Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DarkTurquoise}" />
		<Setter Property="VerticalGridLinesBrush" Value="{StaticResource DarkTurquoise}" />
	</Style>

	<!--  DataGrid Column Header Style  -->
	<Style TargetType="DataGridColumnHeader">
		<Setter Property="Background" Value="{StaticResource HeaderBackground}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="Padding" Value="10,5" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="0,0,1,1" />
	</Style>

	<!--  DataGrid Cell Style - explicitly set to prevent dark mode override  -->
	<Style TargetType="DataGridCell">
		<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="BorderThickness" Value="0" />
		<Style.Triggers>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="{StaticResource SelectionBackground}" />
				<Setter Property="Foreground" Value="{StaticResource SelectionForeground}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--  DataGrid Row Style  -->
	<Style TargetType="DataGridRow">
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Style.Triggers>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="{StaticResource SelectionBackground}" />
				<Setter Property="Foreground" Value="{StaticResource SelectionForeground}" />
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource LightTurquoise}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--  Center-aligned DataGrid cell (for numeric columns)  -->
	<Style x:Key="CenterAlignedCell" TargetType="TextBlock">
		<Setter Property="TextAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Center" />
	</Style>

	<!--
		================================================================
		MENU STYLE
		================================================================
		Professional menu bar with turquoise theme and dropdown popups
		================================================================
	-->

	<!--  Menu Bar (Top Level)  -->
	<Style TargetType="Menu">
		<Setter Property="Background" Value="{StaticResource HeaderBackground}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="0,0,0,1" />
	</Style>

	<!--  MenuItem Style  -->
	<Style TargetType="MenuItem">
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="MenuItem">
					<Border
						Name="Border"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}">
						<Grid>
							<!--  Top-level menu item (File, Backup, etc.)  -->
							<Grid Name="TopLevelGrid" Visibility="Collapsed">
								<Border
									Name="TopLevelBorder"
									Padding="15,5"
									Background="Transparent">
									<ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
								</Border>
							</Grid>

							<!--  Submenu item (Exit, New Backup, etc.)  -->
							<Grid Name="SubmenuGrid" Visibility="Collapsed">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="25" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
									<ColumnDefinition Width="20" />
								</Grid.ColumnDefinitions>

								<!--  Check mark / Icon  -->
								<ContentPresenter
									Name="Icon"
									Grid.Column="0"
									Margin="5,0"
									VerticalAlignment="Center"
									ContentSource="Icon" />

								<!--  Header Text  -->
								<ContentPresenter
									Name="HeaderHost"
									Grid.Column="1"
									Margin="5,3"
									VerticalAlignment="Center"
									ContentSource="Header"
									RecognizesAccessKey="True" />

								<!--  Shortcut Text  -->
								<TextBlock
									Name="InputGestureText"
									Grid.Column="2"
									Margin="5,3,10,3"
									VerticalAlignment="Center"
									Text="{TemplateBinding InputGestureText}" />

								<!--  Submenu Arrow  -->
								<Path
									Name="ArrowPath"
									Grid.Column="3"
									Margin="0,0,5,0"
									VerticalAlignment="Center"
									Data="M 0 0 L 4 3.5 L 0 7 Z"
									Fill="{StaticResource PrimaryText}"
									Visibility="Collapsed" />
							</Grid>

							<!--  Popup for dropdown  -->
							<Popup
								Name="PART_Popup"
								AllowsTransparency="True"
								Focusable="False"
								IsOpen="{TemplateBinding IsSubmenuOpen}"
								Placement="Bottom"
								PopupAnimation="Fade">
								<Border
									Name="SubmenuBorder"
									Background="{StaticResource VeryLightTurquoise}"
									BorderBrush="{StaticResource BorderBrush}"
									BorderThickness="1"
									SnapsToDevicePixels="True">
									<StackPanel
										Grid.IsSharedSizeScope="True"
										IsItemsHost="True"
										KeyboardNavigation.DirectionalNavigation="Cycle" />
								</Border>
							</Popup>
						</Grid>
					</Border>

					<ControlTemplate.Triggers>
						<!--  Top-level menu item triggers  -->
						<Trigger Property="Role" Value="TopLevelHeader">
							<Setter TargetName="TopLevelGrid" Property="Visibility" Value="Visible" />
							<Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
						</Trigger>
						<Trigger Property="Role" Value="TopLevelItem">
							<Setter TargetName="TopLevelGrid" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  Submenu item triggers  -->
						<Trigger Property="Role" Value="SubmenuHeader">
							<Setter TargetName="SubmenuGrid" Property="Visibility" Value="Visible" />
							<Setter TargetName="ArrowPath" Property="Visibility" Value="Visible" />
							<Setter TargetName="PART_Popup" Property="Placement" Value="Right" />
						</Trigger>
						<Trigger Property="Role" Value="SubmenuItem">
							<Setter TargetName="SubmenuGrid" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  Hover effects  -->
						<Trigger Property="IsHighlighted" Value="True">
							<Setter TargetName="Border" Property="Background" Value="{StaticResource LightTurquoise}" />
							<Setter TargetName="TopLevelBorder" Property="Background" Value="{StaticResource LightTurquoise}" />
						</Trigger>

						<!--  Top-level hover with open submenu  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsSubmenuOpen" Value="True" />
								<Condition Property="Role" Value="TopLevelHeader" />
							</MultiTrigger.Conditions>
							<Setter TargetName="TopLevelBorder" Property="Background" Value="{StaticResource MediumTurquoise}" />
						</MultiTrigger>

						<!--  Disabled state  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="#999999" />
						</Trigger>

						<!--  Checkable items  -->
						<Trigger Property="IsCheckable" Value="True">
							<Setter TargetName="Icon" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Icon" Property="Content" Value="✓" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  Separator Style for Menu  -->
	<Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
		<Setter Property="Height" Value="1" />
		<Setter Property="Margin" Value="5,2" />
		<Setter Property="Background" Value="{StaticResource BorderBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Separator">
					<Border Height="1" Background="{TemplateBinding Background}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		================================================================
		STATUSBAR STYLE
		================================================================
	-->
	<Style TargetType="StatusBar">
		<Setter Property="Background" Value="{StaticResource StatusBarBackground}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
	</Style>

	<!--
		================================================================
		TEXTBOX STYLE
		================================================================
	-->
	<Style TargetType="TextBox">
		<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="5,3" />
		<Style.Resources>
			<!--
				This overrides the global ScrollViewer style ONLY for
				the internal ScrollViewer inside this TextBox.
			-->
			<Style TargetType="ScrollViewer">
				<Setter Property="Background" Value="Transparent" />
			</Style>
		</Style.Resources>
	</Style>

	<!--
		================================================================
		COMBOBOX STYLE
		================================================================
	-->
	<Style TargetType="ComboBox">
		<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>

	<!--
		================================================================
		CHECKBOX STYLE
		================================================================
	-->
	<Style TargetType="CheckBox">
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
	</Style>

	<!--
		================================================================
		RADIOBUTTON STYLE
		================================================================
	-->
	<Style TargetType="RadioButton">
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
	</Style>

	<!--
		================================================================
		LABEL STYLE
		================================================================
	-->
	<Style TargetType="Label">
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
	</Style>

	<!--
		================================================================
		TABCONTROL STYLE
		================================================================
	-->
	<Style TargetType="TabControl">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>

	<Style TargetType="TabItem">
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TabItem">
					<Border
						Name="Border"
						Padding="10,5"
						Background="{StaticResource VeryLightTurquoise}"
						BorderBrush="{StaticResource BorderBrush}"
						BorderThickness="1,1,1,0"
						CornerRadius="3,3,0,0">
						<ContentPresenter
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							ContentSource="Header" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Border" Property="Background" Value="{StaticResource MediumTurquoise}" />
							<Setter Property="FontWeight" Value="Bold" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Border" Property="Background" Value="{StaticResource LightTurquoise}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		================================================================
		SCROLLVIEWER STYLE
		================================================================
	-->
	<Style TargetType="ScrollViewer">
		<Setter Property="Background" Value="{StaticResource MediumTurquoise}" />
	</Style>
	<!--
		================================================================
		SCROLLBAR STYLES
		================================================================
		All sub-templates (thumb, arrows, page buttons) are defined
		fully inline inside each ControlTemplate.  No Style= cross-
		references are used inside ControlTemplate content because WPF
		cannot reliably resolve keyed styles from a merged dictionary
		at template-application time — doing so silently breaks the
		entire ResourceDictionary.

		Track      = MediumTurquoise  (#48D1CC)
		Thumb      = ButtonBackground (#008B8B dark cyan)
		Thumb hover= ButtonHover      (#20B2AA light sea green)
		Thumb drag = ButtonPressed    (#5F9EA0 cadet blue)
		Arrows     = DarkTurquoise    (#00CED1)
		Arrow glyph= ButtonForeground (#000000 black)
		================================================================
	-->
	<!--  ── Vertical ScrollBar ControlTemplate  ──────────────────── -->
	<ControlTemplate x:Key="VerticalScrollBarTemplate"
					 TargetType="ScrollBar">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="18" />
				<RowDefinition Height="*" />
				<RowDefinition Height="18" />
			</Grid.RowDefinitions>
			<!--  Track groove  -->
			<Border Grid.Row="1"
					Background="{StaticResource MediumTurquoise}"
					BorderBrush="{StaticResource LightBorderBrush}"
					BorderThickness="1,0" />
			<!--  Line-Up arrow button  -->
			<RepeatButton Grid.Row="0"
						  Command="ScrollBar.LineUpCommand">
				<RepeatButton.Template>
					<ControlTemplate TargetType="RepeatButton">
						<Border x:Name="ArrowBd"
								Background="{StaticResource DarkTurquoise}"
								BorderBrush="{StaticResource BorderBrush}"
								BorderThickness="1"
								CornerRadius="2">
							<Path Width="8"
								  Height="5"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Data="M 0 5 L 4 0 L 8 5 Z"
								  Fill="{StaticResource ButtonForeground}"
								  Stretch="Fill" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver"
									 Value="True">
								<Setter TargetName="ArrowBd"
										Property="Background"
										Value="{StaticResource ButtonHover}" />
							</Trigger>
							<Trigger Property="IsPressed"
									 Value="True">
								<Setter TargetName="ArrowBd"
										Property="Background"
										Value="{StaticResource ButtonPressed}" />
							</Trigger>
							<Trigger Property="IsEnabled"
									 Value="False">
								<Setter TargetName="ArrowBd"
										Property="Opacity"
										Value="0.4" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</RepeatButton.Template>
			</RepeatButton>
			<!--  Track + Thumb  -->
			<Track x:Name="PART_Track"
				   Grid.Row="1"
				   IsDirectionReversed="True">
				<Track.DecreaseRepeatButton>
					<RepeatButton Command="ScrollBar.PageUpCommand">
						<RepeatButton.Template>
							<ControlTemplate TargetType="RepeatButton">
								<Border Background="Transparent" />
							</ControlTemplate>
						</RepeatButton.Template>
					</RepeatButton>
				</Track.DecreaseRepeatButton>
				<Track.Thumb>
					<Thumb MinHeight="20">
						<Thumb.Template>
							<ControlTemplate TargetType="Thumb">
								<Border x:Name="ThumbBd"
										Margin="2,0"
										Background="{StaticResource ButtonBackground}"
										BorderBrush="{StaticResource BorderBrush}"
										BorderThickness="1"
										CornerRadius="3" />
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver"
											 Value="True">
										<Setter TargetName="ThumbBd"
												Property="Background"
												Value="{StaticResource ButtonHover}" />
									</Trigger>
									<Trigger Property="IsDragging"
											 Value="True">
										<Setter TargetName="ThumbBd"
												Property="Background"
												Value="{StaticResource ButtonPressed}" />
									</Trigger>
									<Trigger Property="IsEnabled"
											 Value="False">
										<Setter TargetName="ThumbBd"
												Property="Opacity"
												Value="0.4" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Thumb.Template>
					</Thumb>
				</Track.Thumb>
				<Track.IncreaseRepeatButton>
					<RepeatButton Command="ScrollBar.PageDownCommand">
						<RepeatButton.Template>
							<ControlTemplate TargetType="RepeatButton">
								<Border Background="Transparent" />
							</ControlTemplate>
						</RepeatButton.Template>
					</RepeatButton>
				</Track.IncreaseRepeatButton>
			</Track>
			<!--  Line-Down arrow button  -->
			<RepeatButton Grid.Row="2"
						  Command="ScrollBar.LineDownCommand">
				<RepeatButton.Template>
					<ControlTemplate TargetType="RepeatButton">
						<Border x:Name="ArrowBd"
								Background="{StaticResource DarkTurquoise}"
								BorderBrush="{StaticResource BorderBrush}"
								BorderThickness="1"
								CornerRadius="2">
							<Path Width="8"
								  Height="5"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Data="M 0 0 L 4 5 L 8 0 Z"
								  Fill="{StaticResource ButtonForeground}"
								  Stretch="Fill" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver"
									 Value="True">
								<Setter TargetName="ArrowBd"
										Property="Background"
										Value="{StaticResource ButtonHover}" />
							</Trigger>
							<Trigger Property="IsPressed"
									 Value="True">
								<Setter TargetName="ArrowBd"
										Property="Background"
										Value="{StaticResource ButtonPressed}" />
							</Trigger>
							<Trigger Property="IsEnabled"
									 Value="False">
								<Setter TargetName="ArrowBd"
										Property="Opacity"
										Value="0.4" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</RepeatButton.Template>
			</RepeatButton>
		</Grid>
	</ControlTemplate>
	<!--  ── Horizontal ScrollBar ControlTemplate  ─────────────────── -->
	<ControlTemplate x:Key="HorizontalScrollBarTemplate"
					 TargetType="ScrollBar">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="18" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="18" />
			</Grid.ColumnDefinitions>
			<!--  Track groove  -->
			<Border Grid.Column="1"
					Background="{StaticResource MediumTurquoise}"
					BorderBrush="{StaticResource LightBorderBrush}"
					BorderThickness="0,1" />
			<!--  Line-Left arrow button  -->
			<RepeatButton Grid.Column="0"
						  Command="ScrollBar.LineLeftCommand">
				<RepeatButton.Template>
					<ControlTemplate TargetType="RepeatButton">
						<Border x:Name="ArrowBd"
								Background="{StaticResource DarkTurquoise}"
								BorderBrush="{StaticResource BorderBrush}"
								BorderThickness="1"
								CornerRadius="2">
							<Path Width="5"
								  Height="8"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Data="M 5 0 L 0 4 L 5 8 Z"
								  Fill="{StaticResource ButtonForeground}"
								  Stretch="Fill" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver"
									 Value="True">
								<Setter TargetName="ArrowBd"
										Property="Background"
										Value="{StaticResource ButtonHover}" />
							</Trigger>
							<Trigger Property="IsPressed"
									 Value="True">
								<Setter TargetName="ArrowBd"
										Property="Background"
										Value="{StaticResource ButtonPressed}" />
							</Trigger>
							<Trigger Property="IsEnabled"
									 Value="False">
								<Setter TargetName="ArrowBd"
										Property="Opacity"
										Value="0.4" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</RepeatButton.Template>
			</RepeatButton>
			<!--  Track + Thumb  -->
			<Track x:Name="PART_Track"
				   Grid.Column="1"
				   IsDirectionReversed="False">
				<Track.DecreaseRepeatButton>
					<RepeatButton Command="ScrollBar.PageLeftCommand">
						<RepeatButton.Template>
							<ControlTemplate TargetType="RepeatButton">
								<Border Background="Transparent" />
							</ControlTemplate>
						</RepeatButton.Template>
					</RepeatButton>
				</Track.DecreaseRepeatButton>
				<Track.Thumb>
					<Thumb MinWidth="20">
						<Thumb.Template>
							<ControlTemplate TargetType="Thumb">
								<Border x:Name="ThumbBd"
										Margin="0,2"
										Background="{StaticResource ButtonBackground}"
										BorderBrush="{StaticResource BorderBrush}"
										BorderThickness="1"
										CornerRadius="3" />
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver"
											 Value="True">
										<Setter TargetName="ThumbBd"
												Property="Background"
												Value="{StaticResource ButtonHover}" />
									</Trigger>
									<Trigger Property="IsDragging"
											 Value="True">
										<Setter TargetName="ThumbBd"
												Property="Background"
												Value="{StaticResource ButtonPressed}" />
									</Trigger>
									<Trigger Property="IsEnabled"
											 Value="False">
										<Setter TargetName="ThumbBd"
												Property="Opacity"
												Value="0.4" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Thumb.Template>
					</Thumb>
				</Track.Thumb>
				<Track.IncreaseRepeatButton>
					<RepeatButton Command="ScrollBar.PageRightCommand">
						<RepeatButton.Template>
							<ControlTemplate TargetType="RepeatButton">
								<Border Background="Transparent" />
							</ControlTemplate>
						</RepeatButton.Template>
					</RepeatButton>
				</Track.IncreaseRepeatButton>
			</Track>
			<!--  Line-Right arrow button  -->
			<RepeatButton Grid.Column="2"
						  Command="ScrollBar.LineRightCommand">
				<RepeatButton.Template>
					<ControlTemplate TargetType="RepeatButton">
						<Border x:Name="ArrowBd"
								Background="{StaticResource DarkTurquoise}"
								BorderBrush="{StaticResource BorderBrush}"
								BorderThickness="1"
								CornerRadius="2">
							<Path Width="5"
								  Height="8"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Data="M 0 0 L 5 4 L 0 8 Z"
								  Fill="{StaticResource ButtonForeground}"
								  Stretch="Fill" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver"
									 Value="True">
								<Setter TargetName="ArrowBd"
										Property="Background"
										Value="{StaticResource ButtonHover}" />
							</Trigger>
							<Trigger Property="IsPressed"
									 Value="True">
								<Setter TargetName="ArrowBd"
										Property="Background"
										Value="{StaticResource ButtonPressed}" />
							</Trigger>
							<Trigger Property="IsEnabled"
									 Value="False">
								<Setter TargetName="ArrowBd"
										Property="Opacity"
										Value="0.4" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</RepeatButton.Template>
			</RepeatButton>
		</Grid>
	</ControlTemplate>
	<!--  ── Implicit ScrollBar style — picks template by Orientation  -->
	<Style TargetType="ScrollBar">
		<Setter Property="SnapsToDevicePixels"
				Value="True" />
		<Setter Property="OverridesDefaultStyle"
				Value="True" />
		<Style.Triggers>
			<Trigger Property="Orientation"
					 Value="Vertical">
				<Setter Property="Width"
						Value="14" />
				<Setter Property="MinWidth"
						Value="14" />
				<Setter Property="Template"
						Value="{StaticResource VerticalScrollBarTemplate}" />
			</Trigger>
			<Trigger Property="Orientation"
					 Value="Horizontal">
				<Setter Property="Height"
						Value="14" />
				<Setter Property="MinHeight"
						Value="14" />
				<Setter Property="Template"
						Value="{StaticResource HorizontalScrollBarTemplate}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<!--
		================================================================
		BORDER STYLE
		================================================================
	-->
	<Style TargetType="Border">
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
	</Style>

	<!--
		================================================================
		LISTBOX STYLE
		================================================================
	-->
	<Style TargetType="ListBox">
		<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>

	<Style TargetType="ListBoxItem">
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Style.Triggers>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="{StaticResource SelectionBackground}" />
				<Setter Property="Foreground" Value="{StaticResource SelectionForeground}" />
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource LightTurquoise}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--
		================================================================
		TREEVIEW STYLE
		================================================================
	-->
	<Style TargetType="TreeView">
		<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>

	<Style TargetType="TreeViewItem">
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Style.Triggers>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="{StaticResource SelectionBackground}" />
				<Setter Property="Foreground" Value="{StaticResource SelectionForeground}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--
		================================================================
		EXPANDER STYLE
		================================================================
	-->
	<Style TargetType="Expander">
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
	</Style>

	<!--
		================================================================
		GROUPBOX STYLE
		================================================================
	-->
	<Style TargetType="GroupBox">
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>

	<!--
		================================================================
		PROGRESSBAR STYLE
		================================================================
	-->
	<Style TargetType="ProgressBar">
		<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="Foreground" Value="{StaticResource ButtonBackground}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Height" Value="20" />
	</Style>

	<!--
		================================================================
		SPECIAL BUTTON STYLES
		================================================================
	-->

	<!--  Delete/Remove Button (Dark Red)  -->
	<Style
		x:Key="DeleteButton"
		BasedOn="{StaticResource TurquoiseButton}"
		TargetType="Button">
		<Setter Property="Background" Value="#8B0000" />
		<!--  Dark Red  -->
		<Setter Property="Foreground" Value="{StaticResource VeryLightTurquoise}" />
	</Style>

	<!--  Success/Confirm Button (Dark Green accent)  -->
	<Style
		x:Key="SuccessButton"
		BasedOn="{StaticResource TurquoiseButton}"
		TargetType="Button">
		<Setter Property="Background" Value="#20B2AA" />
		<!--  Light Sea Green  -->
	</Style>

	<!--  Warning Button  -->
	<Style
		x:Key="WarningButton"
		BasedOn="{StaticResource TurquoiseButton}"
		TargetType="Button">
		<Setter Property="Background" Value="#FF8C00" />
		<!--  Dark Orange  -->
		<Setter Property="Foreground" Value="{StaticResource VeryLightTurquoise}" />
	</Style>

	<!--  Neutral/Secondary Button (Lighter Turquoise)  -->
	<Style
		x:Key="SecondaryButton"
		BasedOn="{StaticResource TurquoiseButton}"
		TargetType="Button">
		<Setter Property="Background" Value="#48D1CC" />
		<!--  Medium Turquoise  -->
	</Style>

	<!--
		================================================================
		TOOLTIP STYLE
		================================================================
	-->
	<Style TargetType="ToolTip">
		<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="5" />
	</Style>

	<!--
		================================================================
		CONTEXTMENU STYLE
		================================================================
	-->
	<Style TargetType="ContextMenu">
		<Setter Property="Background" Value="{StaticResource VeryLightTurquoise}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>

</ResourceDictionary>
