<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net8.0-windows</TargetFramework>
	<Nullable>enable</Nullable>
	<Platforms>x64</Platforms>
	<RootNamespace>SecureServerBackupCommon</RootNamespace>
	<AssemblyName>SecureServerBackupCommon</AssemblyName>
	<!-- Version, OutputPath, and Runtime config generation come from Directory.Build.props -->
	<UseWPF>true</UseWPF>
	<AssemblyTitle>SecureServerBackupCommon</AssemblyTitle>
	<Win32Resource>SSB_LogoWinIcosM.res</Win32Resource>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SSB_LogoWinIcos.ico" />
    <Content Include="SSB_LogoWinIcosM.res">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
