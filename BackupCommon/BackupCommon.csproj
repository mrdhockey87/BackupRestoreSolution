<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net8.0-windows</TargetFramework>
	<Nullable>enable</Nullable>
	<Platforms>x64</Platforms>
	<RootNamespace>SecureServerBackupCommon</RootNamespace>
	<AssemblyName>SecureServerBackupCommon</AssemblyName>
	<!-- Version, OutputPath, and Runtime config generation come from Directory.Build.props -->
	<UseWPF>true</UseWPF>
	<AssemblyTitle>SecureServerBackupCommon</AssemblyTitle>
	<ApplicationIcon>SSB_LogoWinIcos.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SSB_LogoWinIcos.ico" />
  </ItemGroup>

</Project>
