<Project>
<!-- This file is imported AFTER the project file, so it overrides any settings in the .vcxproj -->
  
<!-- ================================================================
     AUTOMATIC SERVICE STOP BEFORE BUILD/REBUILD/CLEAN
     ================================================================
     Automatically stops and uninstalls BackupRestoreService before
     building BackupService project to prevent file locking issues
     ================================================================ -->
<Target Name="StopServiceBeforeBuild" 
        BeforeTargets="BeforeBuild;BeforeRebuild;BeforeClean"
        Condition="'$(MSBuildProjectName)' == 'BackupService'">
    
  <Message Importance="High" Text="[AUTO-CLEANUP] Stopping BackupRestoreService before build..." />
    
  <!-- Stop the service -->
  <Exec Command="net stop BackupRestoreService" 
        IgnoreExitCode="true" 
        ContinueOnError="true" />
    
  <!-- Wait 1 second for service to fully stop -->
  <Exec Command="ping 127.0.0.1 -n 2 &gt; nul" 
        IgnoreExitCode="true" />
    
  <!-- Delete the service -->
  <Exec Command="sc delete BackupRestoreService" 
        IgnoreExitCode="true" 
        ContinueOnError="true" />
    
  <Message Importance="High" Text="[AUTO-CLEANUP] Service stopped and uninstalled (if it was running)" />
</Target>

<!-- Ensure SolutionDir is properly set -->
<PropertyGroup>
  <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
</PropertyGroup>
  
  <!-- Force override for C++ projects with consistent relative paths -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <OutDir>$(ArtifactsBin)$(Configuration)\</OutDir>
    <IntDir>$(ArtifactsObj)$(MSBuildProjectName)\$(Configuration)\</IntDir>
  </PropertyGroup>

  <Target Name="__EchoFinalPaths" BeforeTargets="Build">
    <Message Importance="High" Text="[FINAL $(MSBuildProjectName)] OutDir=$(OutDir) IntDir=$(IntDir) SolutionDir=$(SolutionDir)" />
  </Target>

  <!-- ================================================================
       VERIFY AND COPY RUNTIME CONFIG FILES TO OUTPUT
       ================================================================
       MSBuild generates runtime config to different locations depending on project type
       This target ensures they end up in the correct OutputPath for both Debug and Release
       ================================================================ -->
  <Target Name="EnsureRuntimeConfigInOutput" 
          AfterTargets="GenerateBuildRuntimeConfigurationFiles;Build" 
          Condition="'$(MSBuildProjectExtension)' != '.vcxproj' AND ('$(OutputType)' == 'Exe' OR '$(OutputType)' == 'WinExe')">

    <PropertyGroup>
      <!-- Diagnostic: Show all paths being checked -->
      <RuntimeConfigInOutput>$(OutputPath)$(TargetName).runtimeconfig.json</RuntimeConfigInOutput>
      <RuntimeConfigInBin>$(ArtifactsBin)$(TargetName).runtimeconfig.json</RuntimeConfigInBin>
      <RuntimeConfigInBase>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetName).runtimeconfig.json</RuntimeConfigInBase>
      <RuntimeConfigInObj>$(IntermediateOutputPath)$(TargetName).runtimeconfig.json</RuntimeConfigInObj>
    </PropertyGroup>

    <Message Importance="High" Text="[$(MSBuildProjectName) $(Configuration)] Ensuring runtime config in correct location..." />
    <Message Importance="High" Text="  Target: $(RuntimeConfigInOutput)" />
    <Message Importance="High" Text="  Checking: $(RuntimeConfigInBin) - Exists: $([System.IO.File]::Exists('$(RuntimeConfigInBin)'))" />
    <Message Importance="High" Text="  Checking: $(RuntimeConfigInBase) - Exists: $([System.IO.File]::Exists('$(RuntimeConfigInBase)'))" />
    <Message Importance="High" Text="  Checking: $(RuntimeConfigInObj) - Exists: $([System.IO.File]::Exists('$(RuntimeConfigInObj)'))" />

    <!-- Copy from artifacts\bin\ if it exists there -->
    <Copy SourceFiles="$(RuntimeConfigInBin)" 
          DestinationFiles="$(RuntimeConfigInOutput)" 
          SkipUnchangedFiles="false"
          Condition="Exists('$(RuntimeConfigInBin)') AND !Exists('$(RuntimeConfigInOutput)')">
      <Output TaskParameter="CopiedFiles" ItemName="RuntimeConfigCopied"/>
    </Copy>

    <!-- Copy from base intermediate if it exists there -->
    <Copy SourceFiles="$(RuntimeConfigInBase)" 
          DestinationFiles="$(RuntimeConfigInOutput)" 
          SkipUnchangedFiles="false"
          Condition="Exists('$(RuntimeConfigInBase)') AND !Exists('$(RuntimeConfigInOutput)')">
      <Output TaskParameter="CopiedFiles" ItemName="RuntimeConfigCopied2"/>
    </Copy>

    <!-- Copy from obj folder if it exists there -->
    <Copy SourceFiles="$(RuntimeConfigInObj)" 
          DestinationFiles="$(RuntimeConfigInOutput)" 
          SkipUnchangedFiles="false"
          Condition="Exists('$(RuntimeConfigInObj)') AND !Exists('$(RuntimeConfigInOutput)')">
      <Output TaskParameter="CopiedFiles" ItemName="RuntimeConfigCopied3"/>
    </Copy>

    <Message Importance="High" Text="  ✓ Runtime config exists: $(RuntimeConfigInOutput)" Condition="Exists('$(RuntimeConfigInOutput)')" />
    <Message Importance="High" Text="  ✓ Copied from $(RuntimeConfigInBin)" Condition="'@(RuntimeConfigCopied)' != ''" />
    <Message Importance="High" Text="  ✓ Copied from $(RuntimeConfigInBase)" Condition="'@(RuntimeConfigCopied2)' != ''" />
    <Message Importance="High" Text="  ✓ Copied from $(RuntimeConfigInObj)" Condition="'@(RuntimeConfigCopied3)' != ''" />
    <Warning Text="  ⚠️ Runtime config NOT FOUND in any location - Application will fail to launch! Run 'dotnet build' to regenerate." 
             Condition="!Exists('$(RuntimeConfigInOutput)') AND !Exists('$(RuntimeConfigInBin)') AND !Exists('$(RuntimeConfigInBase)') AND !Exists('$(RuntimeConfigInObj)')" />
  </Target>

</Project>

